// ksuid.سو — KSUID (Segment): 27 حرفاً base62 = 32 بت زمن (ثواني منذ 2014-05-13) + 128 بت عشوائي، مرتب زمنياً
استورد "./اساس"

خل حقبة = 1400000000   // ثواني يونكس

دالة _ترميز(ثواني, حمولة_hex) {
  ارجع اساس.hex_الى_قاعدة(اساس.hex_من_رقم(ثواني - حقبة, 8) + حمولة_hex, اساس.ابجدية_base62, 27)
}
دالة جديد(خيارات = عدم) {
  خل ث = اساس.خيار(خيارات, "زمن_ثواني")
  اذا ث == عدم { ث = اساس.الان_مللي() \ 1000 }
  ارجع _ترميز(ث, اساس.عشوائي_hex(16, اساس.خيار(خيارات, "عشوائي")))
}
دالة من_اجزاء(ثواني, حمولة_hex) {
  اذا ليس اساس.هل_hex(حمولة_hex, 32) { ارمي "الحمولة 16 بايتاً (32 خانة hex)" }
  ارجع _ترميز(ثواني, حمولة_hex)
}
دالة هل_صالح(س) {
  اذا نوع(س) != "نص" او س.طول != 27 { ارجع غلط }
  لكل ح في س.حروف() { اذا ليس (ح في اساس.ابجدية_base62) { ارجع غلط } }
  حاول { اساس.قاعدة_الى_بايتات(س, اساس.ابجدية_base62, 20); ارجع صح } امسك (خ) { ارجع غلط }
}
دالة حلل(س) {
  اذا ليس هل_صالح(س) { ارمي "KSUID غير صالح: " + نص(س) }
  خل ه = اساس.قاعدة_الى_hex(س, اساس.ابجدية_base62, 20)
  ارجع {"ثواني": رقم("0x" + ه.جزء(0, 8)) + حقبة, "حمولة": ه.جزء(8)}
}
دالة زمن_من(س) { ارجع حلل(س)["ثواني"] }
