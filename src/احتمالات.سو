// احتمالات.سو — كم معرّفاً يمكن توليده قبل أن يصبح التصادم محتملاً؟ (مسألة أعياد الميلاد)
استورد "رياضيات"
استورد "./اساس"

// بتات العشوائية الفعلية لكل نوع (ضمن وحدته الزمنية إن وُجدت)
خل جدول_البتات = {
  "uuid4": {"بتات": 122, "وحدة": "ابدا"},
  "uuid7": {"بتات": 74, "وحدة": "مللي ثانية"},
  "uuid1": {"بتات": 14, "وحدة": "100 نانوثانية (مع عقدة فريدة: صفر تصادم عملياً)"},
  "ulid": {"بتات": 80, "وحدة": "مللي ثانية"},
  "ksuid": {"بتات": 128, "وحدة": "ثانية"},
  "typeid": {"بتات": 74, "وحدة": "مللي ثانية"},
  "nanoid": {"بتات": 126, "وحدة": "ابدا"},
  "objectid": {"بتات": 40, "وحدة": "ثانية (لكل عملية، ومعها عداد 24 بت)"}
}

// احتمال وجود تصادم واحد على الأقل بين `عدد` معرّف ذات `بتات` بتاً عشوائياً
دالة احتمال_تصادم(بتات, عدد) {
  اذا عدد < 2 { ارجع 0 }
  خل س = (عدد * (عدد - 1) / 2) / (2 ** بتات)
  اذا س < 0.000001 { ارجع س - س * س / 2 }
  ارجع 1 - رياضيات.اس(-س)
}
// أقل عدد من المعرّفات يجعل احتمال التصادم يبلغ `احتمال`
دالة عدد_لاحتمال(بتات, احتمال = 0.5) {
  اذا احتمال <= 0 او احتمال >= 1 { ارمي "الاحتمال بين 0 و 1 (غير شاملين)" }
  خل ل = احتمال < 0.000001 ? احتمال + احتمال * احتمال / 2 : -رياضيات.لوغ(1 - احتمال)
  ارجع رياضيات.جذر(2 * (2 ** بتات) * ل)
}
// بتات عشوائية في معرّف nanoid بأبجدية وطول معيّنين
دالة بتات_nanoid(طول, حجم_ابجدية) { ارجع طول * رياضيات.لوغ(حجم_ابجدية) / رياضيات.لوغ(2) }

دالة صيغة_علمية(ق, خانات = 2) {
  اذا ق == 0 { ارجع "0" }
  خل ا = رياضيات.ارضي(رياضيات.لوغ10(ق))
  خل م = ق / (10 ** ا)
  اذا م >= 9.995 { م = 1; ا += 1 }
  ارجع نسق("{:." + نص(خانات) + "f}", م) + "e" + نص(ا)
}
دالة _مقروء(ن) {
  اذا ن >= 1e15 { ارجع صيغة_علمية(ن) }
  خل ق = رياضيات.ارضي(ن)
  خل خ = []; خل ر = نص(ق)
  طالما ر.طول > 3 { خ.اضف(ر.جزء(ر.طول - 3)); ر = ر.جزء(0, ر.طول - 3) }
  خ.اضف(ر)
  ارجع خ.اعكس().ادمج(",")
}
// تقرير نصي بالعربية: نوع ∈ جدول_البتات، وعدد المعرّفات في الوحدة الزمنية الواحدة
دالة تقرير(نوع_معرف, عدد) {
  اذا ليس (نوع_معرف في جدول_البتات) { ارمي "نوع غير معروف: " + نوع_معرف + " (المتاح: " + جدول_البتات.مفاتيح().ادمج("، ") + ")" }
  خل ج = جدول_البتات[نوع_معرف]
  خل ح = احتمال_تصادم(ج["بتات"], عدد)
  خل س = "عند توليد " + _مقروء(عدد) + " معرّف من نوع " + نوع_معرف
  اذا ج["وحدة"] != "ابدا" { س += " ضمن " + ج["وحدة"] + " واحدة" }
  ارجع س + " فاحتمال حدوث تصادم واحد على الأقل ≈ " + صيغة_علمية(ح)
}
// أكبر كمية آمنة عند حد احتمال معيّن (افتراضياً واحد في المليار)
دالة كمية_آمنة(نوع_معرف, احتمال = 1e-9) {
  اذا ليس (نوع_معرف في جدول_البتات) { ارمي "نوع غير معروف: " + نوع_معرف }
  ارجع رياضيات.ارضي(عدد_لاحتمال(جدول_البتات[نوع_معرف]["بتات"], احتمال))
}
