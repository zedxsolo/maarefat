// ulid.سو — ULID: 26 حرفاً (Crockford base32) = 48 بت زمن + 80 بت عشوائي، مرتب أبجدياً
استورد "./اساس"
استورد "./uuid"

خل _حالة = {"مللي": 0, "عشوائي": عدم}

دالة _زد(ب) {   // يزيد عدداً كبيراً (قائمة بايتات) بواحد؛ يعيد غلط عند الفيض
  لكل ر في مدى(ب.طول - 1, -1, -1) {
    اذا ب[ر] < 255 { ب[ر] += 1; ارجع صح }
    ب[ر] = 0
  }
  ارجع غلط
}
دالة _ترميز(مللي, عشوائي_hex) {
  اذا مللي < 0 او مللي >= 281474976710656 { ارمي "زمن ULID خارج نطاق 48 بت" }
  ارجع اساس.hex_الى_قاعدة(اساس.hex_من_رقم(مللي, 12) + عشوائي_hex, اساس.ابجدية_كروكفورد, 26)
}
// خيارات: "زمن" مللي، "عشوائي" مصدر، "مرتب" (افتراضي صح): يضمن الترتيب داخل نفس المللي ثانية
دالة جديد(خيارات = عدم) {
  خل مصدر = اساس.خيار(خيارات, "عشوائي")
  خل مرتب = اساس.خيار(خيارات, "مرتب", صح)
  خل صريح = اساس.خيار(خيارات, "زمن")
  اذا صريح != عدم { ارجع _ترميز(صريح, اساس.عشوائي_hex(10, مصدر)) }
  خل الان = اساس.الان_مللي()
  اذا ليس مرتب { ارجع _ترميز(الان, اساس.عشوائي_hex(10, مصدر)) }
  اذا الان > _حالة["مللي"] او _حالة["عشوائي"] == عدم {
    _حالة["مللي"] = الان
    _حالة["عشوائي"] = اساس.عشوائي_بايتات(10, مصدر)
  } والا {
    اذا ليس _زد(_حالة["عشوائي"]) {
      _حالة["مللي"] += 1
      _حالة["عشوائي"] = اساس.عشوائي_بايتات(10, مصدر)
    }
  }
  ارجع _ترميز(_حالة["مللي"], اساس.hex_من_بايتات(_حالة["عشوائي"]))
}
دالة من_زمن(مللي, خيارات = عدم) {
  خل ق = {"زمن": مللي}
  اذا خيارات != عدم { لكل ك, ن في خيارات { اذا ك != "زمن" { ق[ك] = ن } } }
  ارجع جديد(ق)
}
// يطبّع الإدخال: حروف كبيرة، I/L ← 1، O ← 0 (كما في مواصفة Crockford)
دالة _طبّع(س) {
  ارجع ارقام_لاتينية(نص(س)).نظف().كبير().ابدل("I", "1").ابدل("L", "1").ابدل("O", "0")
}
دالة هل_صالح(س) {
  اذا نوع(س) != "نص" { ارجع غلط }
  خل ق = _طبّع(س)
  اذا ق.طول != 26 او ق[0] > "7" { ارجع غلط }
  لكل ح في ق.حروف() { اذا ليس (ح في اساس.ابجدية_كروكفورد) { ارجع غلط } }
  ارجع صح
}
دالة حلل(س) {
  اذا ليس هل_صالح(س) { ارمي "ULID غير صالح: " + نص(س) }
  ارجع اساس.قاعدة_الى_hex(_طبّع(س), اساس.ابجدية_كروكفورد, 16)
}
دالة زمن_من(س) { ارجع رقم("0x" + حلل(س).جزء(0, 12)) }
دالة الى_uuid(س) { ارجع uuid.من_بايتات(اساس.بايتات_من_hex(حلل(س))) }
دالة من_uuid(س) { ارجع اساس.hex_الى_قاعدة(uuid.حلل(س), اساس.ابجدية_كروكفورد, 26) }
