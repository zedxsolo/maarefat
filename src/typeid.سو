// typeid.سو — TypeID: بادئة نوعية + "_" + UUIDv7 مرمّز base32 (26 حرفاً): user_01h455vb4pex5vsknk084sn02q
// يجمع مزايا UUID (ترتيب زمني) مع قراءة واضحة لنوع الكيان من المعرّف نفسه.
استورد "./اساس"
استورد "./uuid"

دالة هل_بادئة_صالحة(ب) {
  اذا نوع(ب) != "نص" { ارجع غلط }
  اذا ب == "" { ارجع صح }
  اذا ب.طول > 63 او ب[0] == "_" او ب[ب.طول - 1] == "_" { ارجع غلط }
  لكل ح في ب.حروف() { اذا ليس (ح في "abcdefghijklmnopqrstuvwxyz_") { ارجع غلط } }
  ارجع صح
}
دالة _جسم(ه) { ارجع اساس.hex_الى_قاعدة(ه, اساس.ابجدية_كروكفورد_صغيرة, 26) }
دالة _جسم_صالح(ج) {
  اذا ج.طول != 26 او ج[0] > "7" { ارجع غلط }
  لكل ح في ج.حروف() { اذا ليس (ح في اساس.ابجدية_كروكفورد_صغيرة) { ارجع غلط } }
  ارجع صح
}
دالة من_uuid(بادئة, معرف_uuid) {
  اذا ليس هل_بادئة_صالحة(بادئة) { ارمي "بادئة TypeID غير صالحة (حروف a-z و _ فقط، حتى 63، لا تبدأ أو تنتهي بـ _): " + نص(بادئة) }
  خل ج = _جسم(uuid.حلل(معرف_uuid))
  ارجع بادئة == "" ? ج : بادئة + "_" + ج
}
// معرّف جديد بإصدار UUIDv7 (قابل للترتيب زمنياً)
دالة جديد(بادئة = "", خيارات = عدم) { ارجع من_uuid(بادئة, uuid.uuid7(خيارات)) }
دالة حلل(س) {
  اذا نوع(س) != "نص" { ارمي "TypeID غير صالح" }
  خل ق = س
  خل بادئة = ""
  خل ج = ق
  خل ي = -1
  لكل ر في مدى(0, ق.طول) { اذا ق[ر] == "_" { ي = ر } }
  اذا ي >= 0 {
    بادئة = ق.جزء(0, ي); ج = ق.جزء(ي + 1)
    اذا بادئة == "" { ارمي "TypeID: البادئة فارغة قبل _" }
  }
  اذا ليس هل_بادئة_صالحة(بادئة) { ارمي "بادئة TypeID غير صالحة: " + بادئة }
  اذا ليس _جسم_صالح(ج) { ارمي "الجزء الزمني في TypeID غير صالح: " + ج }
  ارجع {"بادئة": بادئة, "uuid": uuid.قياسي(اساس.قاعدة_الى_hex(ج, اساس.ابجدية_كروكفورد_صغيرة, 16))}
}
دالة هل_صالح(س, بادئة = عدم) {
  حاول {
    خل ن = حلل(س)
    ارجع بادئة == عدم او ن["بادئة"] == بادئة
  } امسك (خ) { ارجع غلط }
}
دالة بادئة_من(س) { ارجع حلل(س)["بادئة"] }
دالة زمن_من(س) { ارجع uuid.زمن_معرف(حلل(س)["uuid"]) }
