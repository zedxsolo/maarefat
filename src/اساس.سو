// اساس.سو — أدوات النواة: hex والبايتات والعشوائية وتحويل الأساسات والتكات الزمنية.
// ملاحظة: هذا الملف أُعيد بناؤه من واجهة الاستدعاء في بقية الوحدات (النسخة الأصلية فُقدت).
// كل القيم الثنائية تُمثَّل نصوص hex بحروف صغيرة، والأبجديات نصوص.
استورد "تشفير"
استورد "زمن"
استورد "رياضيات"

// ───────── الأبجديات ─────────
ثابت ابجدية_hex = "0123456789abcdef"
ثابت ابجدية_base36 = "0123456789abcdefghijklmnopqrstuvwxyz"
ثابت ابجدية_base58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
ثابت ابجدية_فليكر58 = "123456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ"
ثابت ابجدية_base62 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
ثابت ابجدية_كروكفورد = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
ثابت ابجدية_كروكفورد_صغيرة = "0123456789abcdefghjkmnpqrstvwxyz"
ثابت ابجدية_base64url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
ثابت ابجدية_روابط = "useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict"

// ───────── الخيارات ─────────
// قيمة خيار من قاموس الخيارات (أو الافتراضي إن كان القاموس عدماً أو الخيار غائباً)
دالة خيار(خيارات, اسم, افتراضي = عدم) {
  اذا خيارات == عدم { ارجع افتراضي }
  خل ق = خيارات.احصل(اسم)
  ارجع ق == عدم ? افتراضي : ق
}

// ───────── hex والبايتات ─────────
خل _جدول2 = []
خل _عكس_hex = {}
لكل ر في مدى(0, 256) {
  خل س = ابجدية_hex[ر \ 16] + ابجدية_hex[ر % 16]
  _جدول2.اضف(س)
  _عكس_hex[س] = ر
}

// هل النص hex صالح (غير فارغ)، وبطول معيّن إن أُعطي
دالة هل_hex(س, ن = عدم) {
  اذا نوع(س) != "نص" او س.طول == 0 { ارجع غلط }
  اذا ن != عدم و س.طول != ن { ارجع غلط }
  لكل ح في س.صغير() {
    اذا ليس (ح في ابجدية_hex) { ارجع غلط }
  }
  ارجع صح
}

دالة بايتات_من_hex(س) {
  اذا نوع(س) != "نص" { ارمي "نص hex غير صالح: المدخل ليس نصاً" }
  اذا س.طول == 0 { ارجع [] }
  اذا س.طول % 2 != 0 او ليس هل_hex(س) { ارمي "نص hex غير صالح" }
  خل ق = س.صغير()
  خل خ = []
  لكل ي في مدى(0, ق.طول, 2) { خ.اضف(_عكس_hex[ق.جزء(ي, ي + 2)]) }
  ارجع خ
}

دالة hex_من_بايتات(ب) {
  خل خ = []
  لكل ع في ب {
    اذا نوع(ع) != "رقم" او ع < 0 او ع > 255 او ع != رياضيات.بتر(ع) { ارمي "قائمة البايتات يجب أن تحوي أرقاماً صحيحة بين 0 و 255" }
    خ.اضف(_جدول2[ع])
  }
  ارجع خ.ادمج("")
}

// نص (UTF-8) ← hex
دالة hex_من_نص(س) {
  اذا نوع(س) != "نص" { ارمي "المدخل يجب أن يكون نصاً" }
  ارجع تشفير.hex(س)
}

// رقم صحيح غير سالب ← hex بعرض ثابت (حشو أصفار من اليسار)
دالة hex_من_رقم(ن, عرض) {
  اذا نوع(ن) != "رقم" او ن < 0 او ن != رياضيات.بتر(ن) { ارمي "الرقم يجب أن يكون صحيحاً غير سالب" }
  خل س = نسق("{:x}", ن)
  اذا س.طول > عرض { ارمي "الرقم " + نص(ن) + " لا يتسع في " + نص(عرض) + " خانة hex" }
  ارجع س.املأ_يسار(عرض, "0")
}

// ───────── الأرقام العشرية (نصوص) ─────────
دالة هل_ارقام_عشرية(س) {
  اذا نوع(س) != "نص" او س.طول == 0 { ارجع غلط }
  لكل ح في س { اذا ليس (ح في "0123456789") { ارجع غلط } }
  ارجع صح
}

// يزيل الأصفار البادئة من نص عشري ويُبقي صفراً واحداً على الأقل
دالة ازل_اصفار_بادئة(س) {
  خل ي = 0
  طالما ي < س.طول - 1 و س[ي] == "0" { ي += 1 }
  ارجع س.جزء(ي)
}

// ───────── العشوائية ─────────
خل _مصدر_عام = عدم

// يضبط مصدر عشوائية عاماً: دالة (ن) ← نص hex بطول 2ن. للاختبارات فقط.
دالة ضبط_المصدر(ف) {
  اذا ليس هل_دالة(ف) { ارمي "المصدر يجب أن يكون دالة (ن) ← نص hex بطول 2ن" }
  _مصدر_عام = ف
}
دالة اعد_المصدر_الافتراضي() { _مصدر_عام = عدم }

// ن بايت عشوائية كنص hex بطول 2ن. المصدر: مصدر الاستدعاء، ثم العام، ثم المولّد الآمن للنظام
دالة عشوائي_hex(ن, مصدر = عدم) {
  اذا ن < 1 او ن != رياضيات.بتر(ن) { ارمي "عدد البايتات يجب أن يكون صحيحاً موجباً" }
  اذا مصدر == عدم { مصدر = _مصدر_عام }
  اذا مصدر == عدم { ارجع تشفير.hex(تشفير.عشوائي_بايتات(ن)) }
  خل ر = مصدر(ن)
  اذا ليس هل_hex(ر, 2 * ن) { ارمي "مصدر العشوائية المخصص يجب أن يعيد نص hex بطول " + نص(2 * ن) + " (" + نص(ن) + " بايت)" }
  ارجع ر.صغير()
}

// ن بايت عشوائية كقائمة أرقام
دالة عشوائي_بايتات(ن, مصدر = عدم) { ارجع بايتات_من_hex(عشوائي_hex(ن, مصدر)) }

// رقم صحيح منتظم في [0, حد) بلا انحياز (أخذ عينات مع رفض)
دالة عشوائي_صحيح(حد, مصدر = عدم) {
  اذا نوع(حد) != "رقم" او حد < 1 او حد != رياضيات.بتر(حد) { ارمي "الحد يجب أن يكون صحيحاً موجباً" }
  اذا حد > 281474976710656 { ارمي "الحد الأقصى 2^48" }
  اذا حد == 1 { ارجع 0 }
  خل ك = 1
  طالما (256 ** ك) < حد { ك += 1 }
  خل مدى_كامل = 256 ** ك
  خل سقف_القبول = (مدى_كامل \ حد) * حد
  طالما صح {
    خل ب = عشوائي_بايتات(ك, مصدر)
    خل ق = 0
    لكل ع في ب { ق = ق * 256 + ع }
    اذا ق < سقف_القبول { ارجع ق % حد }
  }
}

// مولّد عشوائية حتمي من بذرة (نص أو رقم): دالة (ن) ← hex بطول 2ن. للاختبار فقط، غير آمن.
دالة مولد_بذرة(بذرة) {
  خل اصل = "بذرة:" + نص(بذرة)
  خل عداد = [0]
  ارجع دالة(ن) {
    خل خ = ""
    طالما خ.طول < 2 * ن {
      خ = خ + تشفير.sha256(اصل + ":" + نص(عداد[0]))
      عداد[0] = عداد[0] + 1
    }
    ارجع خ.جزء(0, 2 * ن)
  }
}

// ───────── الزمن ─────────
// الوقت الحالي بالمللي ثانية منذ 1970 (صحيح)
دالة الان_مللي() { ارجع رياضيات.بتر(زمن.الان() * 1000) }

// مللي ثانية بتنسيق ISO 8601 بتوقيت UTC: 2022-02-22T19:22:22.000Z
دالة زمن_iso(مللي) {
  خل ث = مللي \ 1000
  خل ج = مللي - ث * 1000
  خل د = زمن.تاريخ(ث, صح)
  ارجع نسق("{:04d}-{:02d}-{:02d}T{:02d}:{:02d}:{:02d}.{:03d}Z", د["سنة"], د["شهر"], د["يوم"], د["ساعة"], د["دقيقة"], د["ثانية"], ج)
}

// عدد المللي ثانية بين 1582-10-15 (حقبة UUID الغريغورية) و1970-01-01
ثابت _فرق_غريغوري = 12219292800000

// (مللي منذ 1970، كسر 0..9999 بوحدة 100ns) ← 15 خانة hex (60 بت)
دالة تكات_من_مللي(مللي, كسر = 0) {
  خل ج = مللي + _فرق_غريغوري
  اذا ج < 0 { ارمي "الزمن قبل 1582-10-15 غير ممثَّل في UUID" }
  خل ثابت_22 = 4194304
  خل أعلى = (ج \ ثابت_22) * 10000
  خل أدنى = (ج % ثابت_22) * 10000 + كسر
  أعلى = أعلى + (أدنى \ ثابت_22)
  أدنى = أدنى % ثابت_22
  خل منخفض32 = (أعلى % 1024) * ثابت_22 + أدنى
  خل مرتفع28 = أعلى \ 1024
  ارجع hex_من_رقم(مرتفع28, 7) + hex_من_رقم(منخفض32, 8)
}

// 15 خانة hex (60 بت) ← [مللي منذ 1970، كسر 0..9999]
دالة مللي_من_تكات(ه) {
  اذا ليس هل_hex(ه, 15) { ارمي "التكات يجب أن تكون 15 خانة hex" }
  خل ق = ه.صغير()
  خل مرتفع = رقم("0x" + ق.جزء(0, 7))
  خل منخفض = رقم("0x" + ق.جزء(7, 15))
  خل خارج1 = مرتفع \ 10000
  خل باقي1 = مرتفع % 10000
  خل س = باقي1 * 4294967296 + منخفض
  خل خارج2 = س \ 10000
  خل كسر = س % 10000
  ارجع [خارج1 * 4294967296 + خارج2 - _فرق_غريغوري, كسر]
}

// ───────── الأساسات (كبير النهاية) ─────────
خل _ابجديات = {}

دالة _جهز(نص_ابجدية) {
  خل م = _ابجديات.احصل(نص_ابجدية)
  اذا م != عدم { ارجع م }
  اذا نوع(نص_ابجدية) != "نص" { ارمي "الأبجدية يجب أن تكون نصاً" }
  خل ح = نص_ابجدية.حروف()
  اذا ح.طول < 2 او ح.طول > 256 { ارمي "طول الأبجدية يجب أن يكون بين 2 و 256" }
  خل ف = {}
  لكل ي في مدى(0, ح.طول) {
    اذا ح[ي] في ف { ارمي "الأبجدية فيها حرف مكرر: " + ح[ي] }
    ف[ح[ي]] = ي
  }
  خل ن = {"حروف": ح, "فهرس": ف}
  _ابجديات[نص_ابجدية] = ن
  ارجع ن
}

// قائمة بايتات ← نص في أساس الأبجدية (حشو من اليسار بحرف الصفر حتى الطول الثابت)
دالة _بايتات_الى_قاعدة(ب, نص_ابجدية, طول_ثابت) {
  خل ا = _جهز(نص_ابجدية)
  خل ح = ا["حروف"]
  خل اساس = ح.طول
  خل ع = []
  لكل د في ب { اذا ع.طول > 0 او د > 0 { ع.اضف(د) } }
  خل خرج = []
  طالما ع.طول > 0 {
    خل باقي = 0
    خل ناتج = []
    لكل د في ع {
      خل حالي = باقي * 256 + د
      خل خ = حالي \ اساس
      باقي = حالي % اساس
      اذا ناتج.طول > 0 او خ > 0 { ناتج.اضف(خ) }
    }
    خرج.اضف(ح[باقي])
    ع = ناتج
  }
  اذا طول_ثابت > 0 و خرج.طول > طول_ثابت { ارمي "القيمة لا تتسع في " + نص(طول_ثابت) + " خانة" }
  طالما خرج.طول < طول_ثابت { خرج.اضف(ح[0]) }
  اذا خرج.طول == 0 { خرج.اضف(ح[0]) }
  ارجع خرج.اعكس().ادمج("")
}

// نص في أساس الأبجدية ← ن بايت (كبير النهاية). يرمي خطأ للحرف غير الصالح أو الفيض
دالة _قاعدة_الى_بايتات(س, نص_ابجدية, ن) {
  اذا نوع(س) != "نص" او س.طول == 0 { ارمي "نص فارغ أو غير صالح" }
  خل ا = _جهز(نص_ابجدية)
  خل ف = ا["فهرس"]
  خل اساس = ا["حروف"].طول
  خل خ = []
  كرر ن { خ.اضف(0) }
  لكل ح في س {
    خل ق = ف.احصل(ح)
    اذا ق == عدم { ارمي "حرف غير صالح في الأبجدية: " + ح }
    خل حمل = ق
    خل ي = ن - 1
    طالما ي >= 0 {
      خل ناتج = خ[ي] * اساس + حمل
      خ[ي] = ناتج % 256
      حمل = ناتج \ 256
      ي -= 1
    }
    اذا حمل > 0 { ارمي "القيمة أكبر من أن تتسع في " + نص(ن) + " بايت" }
  }
  ارجع خ
}

// hex ← نص في أساس الأبجدية، بطول ثابت اختياري
دالة hex_الى_قاعدة(ه, نص_ابجدية, طول_ثابت = 0) {
  اذا ليس هل_hex(ه) { ارمي "نص hex غير صالح" }
  خل ق = ه.طول % 2 == 1 ? "0" + ه : ه
  ارجع _بايتات_الى_قاعدة(بايتات_من_hex(ق), نص_ابجدية, طول_ثابت)
}

// نص في أساس الأبجدية ← hex بطول 2ن
دالة قاعدة_الى_hex(س, نص_ابجدية, ن) { ارجع hex_من_بايتات(_قاعدة_الى_بايتات(س, نص_ابجدية, ن)) }

// نص في أساس الأبجدية ← قائمة من ن بايت
دالة قاعدة_الى_بايتات(س, نص_ابجدية, ن) { ارجع _قاعدة_الى_بايتات(س, نص_ابجدية, ن) }

// ───────── base64url بلا حشو ─────────
دالة base64url_من_hex(ه) {
  اذا ليس هل_hex(ه) او ه.طول % 2 != 0 { ارمي "نص hex غير صالح" }
  خل ب = تشفير.base64(تشفير.فك_hex(ه.صغير()))
  ارجع ب.ابدل("+", "-").ابدل("/", "_").ابدل("=", "")
}

دالة hex_من_base64url(س) {
  اذا نوع(س) != "نص" او س.طول == 0 او س.طول % 4 == 1 { ارمي "نص base64url غير صالح" }
  لكل ح في س { اذا ليس (ح في ابجدية_base64url) { ارمي "نص base64url غير صالح: حرف غير مسموح" } }
  خل ق = س.ابدل("-", "+").ابدل("_", "/")
  طالما ق.طول % 4 != 0 { ق = ق + "=" }
  ارجع تشفير.hex(تشفير.فك_base64(ق))
}
