// nanoid.سو — معرفات قصيرة بأبجدية مخصصة، بلا انحياز إحصائي (قناع + رفض)
استورد "رياضيات"
استورد "./اساس"

خل ابجديات = {
  "روابط": اساس.ابجدية_روابط,
  "ارقام": "0123456789",
  "صغيرة": "abcdefghijklmnopqrstuvwxyz",
  "كبيرة": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "صغيرة_وارقام": "0123456789abcdefghijklmnopqrstuvwxyz",
  "كبيرة_وارقام": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "حروف_وارقام": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
  "hex": "0123456789abcdef",
  // بلا حروف متشابهة (0/O و1/l/I) وبلا حروف علة: يقلل الأخطاء عند القراءة والإملاء وتتجنب الكلمات البذيئة
  "بلا_ملتبس": "6789BCDFGHJKLMNPQRTWbcdfghjkmnpqrtwz",
  "مقروء": "23456789ABCDEFGHJKLMNPQRSTUVWXYZ",
  "عربية": "ابتثجحخدذرزسشصضطظعغفقكلمنهوي",
  "ارقام_هندية": "٠١٢٣٤٥٦٧٨٩",
  "كروكفورد": اساس.ابجدية_كروكفورد,
  "base58": اساس.ابجدية_base58
}

دالة _ابجدية(ا) {
  اذا ا == عدم { ارجع اساس.ابجدية_روابط }
  اذا نوع(ا) == "نص" و ا في ابجديات { ارجع ابجديات[ا] }
  ارجع ا
}

// نانو‌آي‌دي: جديد(طول=21, ابجدية=روابط, خيارات)
دالة جديد(طول = 21, ابجدية = عدم, خيارات = عدم) {
  خل ح = _ابجدية(ابجدية).حروف()
  خل ن = ح.طول
  اذا ن < 2 او ن > 256 { ارمي "طول الأبجدية يجب أن يكون بين 2 و 256" }
  اذا طول < 1 { ارمي "الطول يجب أن يكون 1 على الأقل" }
  اذا ح.فريد().طول != ن { ارمي "الأبجدية فيها حروف مكررة (تفسد التوزيع المنتظم)" }
  خل مصدر = اساس.خيار(خيارات, "عشوائي")
  خل قناع = (2 << (رياضيات.ارضي(رياضيات.لوغ(ن - 1) / رياضيات.لوغ(2)))) - 1
  اذا ن == 2 { قناع = 1 }
  خل خطوة = رياضيات.سقف(1.6 * قناع * طول / ن)
  خل خرج = []
  طالما صح {
    خل ب = اساس.عشوائي_بايتات(خطوة, مصدر)
    لكل ع في ب {
      خل ف = ع & قناع
      اذا ف < ن {
        خرج.اضف(ح[ف])
        اذا خرج.طول == طول { ارجع خرج.ادمج("") }
      }
    }
  }
}
// مولّد مضبوط مسبقاً: مصنع(ابجدية, طول) ← دالة بلا وسائط
دالة مصنع(ابجدية, طول = 21, خيارات = عدم) { ارجع () => جديد(طول, ابجدية, خيارات) }

// ───────── الإنتروبيا والأمان ─────────
دالة بتات_العشوائية(طول, ابجدية = عدم) { ارجع طول * رياضيات.لوغ(_ابجدية(ابجدية).طول) / رياضيات.لوغ(2) }
// أقل طول يعطي عدداً معيناً من بتات العشوائية
دالة طول_مطلوب(بتات, ابجدية = عدم) {
  ارجع رياضيات.سقف(بتات / (رياضيات.لوغ(_ابجدية(ابجدية).طول) / رياضيات.لوغ(2)))
}
