// فحص.سو — يتعرّف على نوع أي معرّف ويستخرج ما فيه (الزمن، الإصدار، العقدة...)
استورد "./اساس"
استورد "./uuid"
استورد "./ulid"
استورد "./ksuid"
استورد "./objectid"
استورد "./typeid"
استورد "./snowflake"
استورد "./حرفي"

خل _اقل_زمن = 1230768000000     // 2009-01-01
خل _اعلى_زمن = 4102444800000    // 2100-01-01

دالة _معقول(مللي) { ارجع مللي != عدم و مللي >= _اقل_زمن و مللي <= _اعلى_زمن }

// يعيد {الاول: أفضل تخمين أو عدم، المرشحون: قائمة}. الثقة: "اكيد" أو "محتمل"
دالة افحص(مدخل) {
  خل ن = []
  خل س = نص(مدخل).نظف()
  خل ه = uuid.حلل_او_عدم(س)
  اذا ه != عدم {
    خل نسخة = uuid.نسخة_من(ه)
    خل ز = {"نوع": "uuid", "ثقة": "اكيد", "uuid": uuid.قياسي(ه), "نسخة": نسخة, "متغير": uuid.متغير_من(ه)}
    اذا ه == "00000000000000000000000000000000" { ز["ملاحظة"] = "UUID الفارغ (nil)" }
    اذا ه == "ffffffffffffffffffffffffffffffff" { ز["ملاحظة"] = "UUID الأقصى (max)" }
    خل زمن = uuid.زمن_معرف(ه)
    اذا زمن != عدم { ز["زمن_مللي"] = زمن; ز["مرتب_زمنيا"] = نسخة != 1 }
    خل ع = uuid.عقدة_معرف(ه)
    اذا ع != عدم { ز["عقدة"] = ع }
    ن.اضف(ز)
  }
  اذا س.يحتوي("_") و س.طول > 27 {
    حاول { خل ت = typeid.حلل(س); ن.اضف({"نوع": "typeid", "ثقة": "اكيد", "بادئة": ت["بادئة"], "uuid": ت["uuid"], "زمن_مللي": uuid.زمن_معرف(ت["uuid"])}) } امسك (خ) { }
  }
  اذا ulid.هل_صالح(س) {
    خل ز = ulid.زمن_من(س)
    ن.اضف({"نوع": "ulid", "ثقة": _معقول(ز) ? "اكيد" : "محتمل", "زمن_مللي": ز})
    اذا س.طول == 26 { ن.اضف({"نوع": "typeid (بلا بادئة)", "ثقة": "محتمل", "uuid": ulid.الى_uuid(س)}) }
  }
  اذا ksuid.هل_صالح(س) {
    خل ك = ksuid.حلل(س)
    اذا _معقول(ك["ثواني"] * 1000) { ن.اضف({"نوع": "ksuid", "ثقة": "اكيد", "زمن_مللي": ك["ثواني"] * 1000, "حمولة": ك["حمولة"]}) }
  }
  اذا objectid.هل_صالح(س) و ه == عدم {
    خل ك = objectid.حلل(س)
    اذا _معقول(ك["ثواني"] * 1000) { ن.اضف({"نوع": "objectid", "ثقة": "اكيد", "زمن_مللي": ك["ثواني"] * 1000, "عملية": ك["عملية"], "عداد": ك["عداد"]}) }
  }
  اذا اساس.هل_ارقام_عشرية(س) و س.طول >= 15 و س.طول <= 20 {
    لكل ا في ["تويتر", "ديسكورد"] {
      خل ف = snowflake.فك(س, {"نمط": ا})
      اذا _معقول(ف["زمن"]) { ن.اضف({"نوع": "snowflake (" + ا + ")", "ثقة": "محتمل", "زمن_مللي": ف["زمن"], "عقدة": ف["عقدة"], "تسلسل": ف["تسلسل"]}) }
    }
  }
  اذا س.طول == 21 {
    خل ك = صح
    لكل ح في س.حروف() { اذا ليس (ح في اساس.ابجدية_روابط) { ك = غلط } }
    اذا ك { ن.اضف({"نوع": "nanoid", "ثقة": "محتمل", "ملاحظة": "21 حرفاً من الأبجدية الافتراضية (لا يحمل زمناً)"}) }
  }
  اذا حرفي.هل_صالح(س) و س.طول >= 20 و ن.طول == 0 { ن.اضف({"نوع": "معرف حرفي (cuid-style)", "ثقة": "محتمل"}) }
  خل افضل = ن.طول > 0 ? ن[0] : عدم
  ارجع {"الاول": افضل, "المرشحون": ن}
}
