// md5.سو — MD5 مكتوب بسولان (لا يوجد MD5 مدمج في اللغة). يلزم فقط لمعرفات UUID الإصدار 3.
// تحذير: MD5 ضعيف تشفيرياً؛ لا تستعمله للأمان. UUIDv3 يستعمله للتوافق فقط.
استورد "رياضيات"
استورد "./اساس"

خل _ك = []
لكل ر في مدى(0, 64) { _ك.اضف(رياضيات.ارضي(رياضيات.مطلق(رياضيات.جيب(ر + 1)) * 4294967296)) }
خل _ش = [7, 12, 17, 22] * 4 + [5, 9, 14, 20] * 4 + [4, 11, 16, 23] * 4 + [6, 10, 15, 21] * 4
خل _م = 4294967295

دالة _دور(س, ع) { ارجع (((س & (_م >> ع)) << ع) | (س >> (32 - ع))) & _م }

// المدخل: قائمة بايتات. المخرج: hex (32 خانة)
دالة md5_بايتات(ب) {
  خل د = ب.انسخ()
  خل ط = ب.طول
  د.اضف(128)
  طالما د.طول % 64 != 56 { د.اضف(0) }
  خل بتات_دنيا = (ط * 8) % 4294967296
  خل بتات_عليا = رياضيات.ارضي(ط * 8 / 4294967296)
  لكل ر في مدى(0, 4) { د.اضف((بتات_دنيا >> (8 * ر)) & 255) }
  لكل ر في مدى(0, 4) { د.اضف((بتات_عليا >> (8 * ر)) & 255) }
  خل ا0 = 1732584193; خل ب0 = 4023233417; خل ج0 = 2562383102; خل د0 = 271733878
  خل ك = 0
  طالما ك < د.طول {
    خل كلمة = []
    لكل ر في مدى(0, 16) {
      خل ق = ك + ر * 4
      كلمة.اضف(د[ق] + د[ق + 1] * 256 + د[ق + 2] * 65536 + د[ق + 3] * 16777216)
    }
    خل ا = ا0; خل ب1 = ب0; خل ج = ج0; خل د1 = د0
    لكل ر في مدى(0, 64) {
      خل ف = 0; خل ع = 0
      اذا ر < 16 { ف = (ب1 & ج) | ((ب1 ^ _م) & د1); ع = ر }
      والا_اذا ر < 32 { ف = (د1 & ب1) | ((د1 ^ _م) & ج); ع = (5 * ر + 1) % 16 }
      والا_اذا ر < 48 { ف = ب1 ^ ج ^ د1; ع = (3 * ر + 5) % 16 }
      والا { ف = ج ^ (ب1 | (د1 ^ _م)); ع = (7 * ر) % 16 }
      ف = (ف + ا + _ك[ر] + كلمة[ع]) & _م
      ا = د1; د1 = ج; ج = ب1
      ب1 = (ب1 + _دور(ف, _ش[ر])) & _م
    }
    ا0 = (ا0 + ا) & _م; ب0 = (ب0 + ب1) & _م; ج0 = (ج0 + ج) & _م; د0 = (د0 + د1) & _م
    ك += 64
  }
  خل خ = []
  لكل ق في [ا0, ب0, ج0, د0] {
    لكل ر في مدى(0, 4) { خ.اضف((ق >> (8 * ر)) & 255) }
  }
  ارجع اساس.hex_من_بايتات(خ)
}
// المدخل: hex لبايتات الرسالة
دالة md5_hex(س) { ارجع md5_بايتات(اساس.بايتات_من_hex(س)) }
// المدخل: نص عادي (UTF-8)
دالة md5(س) { ارجع md5_hex(اساس.hex_من_نص(س)) }
