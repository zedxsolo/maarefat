// objectid.سو — ObjectId (MongoDB): 12 بايتاً = 4 زمن (ثواني) + 5 عشوائي لكل عملية + 3 عداد
استورد "./اساس"

خل _حالة = {"عملية": عدم, "عداد": عدم}

دالة جديد(خيارات = عدم) {
  خل مصدر = اساس.خيار(خيارات, "عشوائي")
  خل ث = اساس.خيار(خيارات, "زمن_ثواني")
  اذا ث == عدم { ث = اساس.الان_مللي() \ 1000 }
  اذا _حالة["عملية"] == عدم {
    _حالة["عملية"] = اساس.عشوائي_hex(5, مصدر)
    _حالة["عداد"] = اساس.عشوائي_صحيح(16777216, مصدر)
  }
  _حالة["عداد"] = (_حالة["عداد"] + 1) % 16777216
  ارجع اساس.hex_من_رقم(ث, 8) + _حالة["عملية"] + اساس.hex_من_رقم(_حالة["عداد"], 6)
}
دالة هل_صالح(س) { ارجع اساس.هل_hex(نوع(س) == "نص" ? س.صغير() : س, 24) }
دالة زمن_من(س) {
  اذا ليس هل_صالح(س) { ارمي "ObjectId غير صالح" }
  ارجع رقم("0x" + س.صغير().جزء(0, 8))
}
دالة حلل(س) {
  اذا ليس هل_صالح(س) { ارمي "ObjectId غير صالح" }
  خل ه = س.صغير()
  ارجع {"ثواني": رقم("0x" + ه.جزء(0, 8)), "عملية": ه.جزء(8, 18), "عداد": رقم("0x" + ه.جزء(18))}
}
