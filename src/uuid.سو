// uuid.سو — UUID كاملة وفق RFC 9562 (تحل محل RFC 4122): الإصدارات 1 إلى 8 + nil + max
// كل الدوال تعيد النص القياسي بحروف صغيرة: xxxxxxxx-xxxx-Mxxx-Nxxx-xxxxxxxxxxxx
استورد "تشفير"
استورد "ضخم"
استورد "رياضيات"
استورد "./اساس"
استورد "./md5"

خل فارغ_uuid = "00000000-0000-0000-0000-000000000000"
خل اقصى_uuid = "ffffffff-ffff-ffff-ffff-ffffffffffff"
خل فضاءات = {
  "dns": "6ba7b810-9dad-11d1-80b4-00c04fd430c8",
  "url": "6ba7b811-9dad-11d1-80b4-00c04fd430c8",
  "oid": "6ba7b812-9dad-11d1-80b4-00c04fd430c8",
  "x500": "6ba7b814-9dad-11d1-80b4-00c04fd430c8",
  "نطاق": "6ba7b810-9dad-11d1-80b4-00c04fd430c8",
  "رابط": "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
}

// ───────── التحليل والصيغ ─────────
دالة _نظف(س) {
  خل ق = ارقام_لاتينية(س).نظف().صغير()
  اذا ق.يبدأ_ب("urn:uuid:") { ق = ق.جزء(9) }
  اذا ق.يبدأ_ب("{") و ق.ينتهي_ب("}") { ق = ق.جزء(1, ق.طول - 1) }
  ارجع ق
}
// يعيد 32 خانة hex أو عدم إن كان النص غير صالح
دالة حلل_او_عدم(س) {
  اذا نوع(س) != "نص" { ارجع عدم }
  خل ق = _نظف(س)
  اذا ق.طول == 36 {
    اذا ق[8] != "-" او ق[13] != "-" او ق[18] != "-" او ق[23] != "-" { ارجع عدم }
    ق = ق.ابدل("-", "")
  }
  اذا ليس اساس.هل_hex(ق, 32) { ارجع عدم }
  ارجع ق
}
// يعيد 32 خانة hex أو يرمي خطأ عربياً واضحاً
دالة حلل(س) {
  خل ه = حلل_او_عدم(س)
  اذا ه == عدم { ارمي "معرّف UUID غير صالح: " + نص(س) }
  ارجع ه
}
دالة _قياسي(ه) { ارجع ه.جزء(0, 8) + "-" + ه.جزء(8, 12) + "-" + ه.جزء(12, 16) + "-" + ه.جزء(16, 20) + "-" + ه.جزء(20) }
دالة قياسي(س) { ارجع _قياسي(حلل(س)) }

// الصيغ: "قياسي" "بسيط" "اقواس" "urn" "كبير" "مختصر" (base64url بـ 22 خانة) "base58" "base62"
دالة نسق_معرف(س, صيغة = "قياسي") {
  خل ه = حلل(س)
  تبديل صيغة {
    حالة "قياسي" { ارجع _قياسي(ه) }
    حالة "بسيط" { ارجع ه }
    حالة "اقواس" { ارجع "{" + _قياسي(ه) + "}" }
    حالة "urn" { ارجع "urn:uuid:" + _قياسي(ه) }
    حالة "كبير" { ارجع _قياسي(ه).كبير() }
    حالة "مختصر" { ارجع اساس.base64url_من_hex(ه) }
    حالة "base58" { ارجع اساس.hex_الى_قاعدة(ه, اساس.ابجدية_فليكر58, 22) }
    حالة "base62" { ارجع اساس.hex_الى_قاعدة(ه, اساس.ابجدية_base62, 22) }
    حالة "هندي" { ارجع ارقام_عربية(_قياسي(ه)) }
    افتراضي { ارمي "صيغة غير معروفة: " + نص(صيغة) }
  }
}
// عكس الصيغ المختصرة
دالة من_مختصر(س) { ارجع _قياسي(اساس.hex_من_base64url(س)) }
دالة من_base58(س) { ارجع _قياسي(اساس.قاعدة_الى_hex(س, اساس.ابجدية_فليكر58, 16)) }
دالة من_base62(س) { ارجع _قياسي(اساس.قاعدة_الى_hex(س, اساس.ابجدية_base62, 16)) }

// ───────── الفحص ─────────
دالة نسخة_من(س) {
  خل ه = حلل(س)
  اذا ه == "00000000000000000000000000000000" او ه == "ffffffffffffffffffffffffffffffff" { ارجع عدم }
  ارجع رقم("0x" + ه[12])
}
دالة متغير_من(س) {
  خل ه = حلل(س)
  خل ن = رقم("0x" + ه[16])
  اذا ن < 8 { ارجع "ncs" }
  اذا ن < 12 { ارجع "rfc9562" }
  اذا ن < 14 { ارجع "microsoft" }
  ارجع "reserved"
}
دالة هل_فارغ(س) { خل ه = حلل_او_عدم(س); ارجع ه == "00000000000000000000000000000000" }
دالة هل_اقصى(س) { خل ه = حلل_او_عدم(س); ارجع ه == "ffffffffffffffffffffffffffffffff" }
// صارم: يقبل النسخ 1..8 بمتغير RFC فقط (والفارغ والأقصى). نسخة: تقييد على نسخة بعينها
دالة هل_صالح(س, نسخة = عدم, صارم = صح) {
  خل ه = حلل_او_عدم(س)
  اذا ه == عدم { ارجع غلط }
  اذا ه == "00000000000000000000000000000000" او ه == "ffffffffffffffffffffffffffffffff" {
    ارجع نسخة == عدم
  }
  خل ن = رقم("0x" + ه[12])
  اذا نسخة != عدم و ن != نسخة { ارجع غلط }
  اذا صارم {
    اذا ن < 1 او ن > 8 { ارجع غلط }
    اذا متغير_من(ه) != "rfc9562" { ارجع غلط }
  }
  ارجع صح
}
دالة حقول(س) {
  خل ه = حلل(س)
  ارجع {
    "time_low": رقم("0x" + ه.جزء(0, 8)), "time_mid": رقم("0x" + ه.جزء(8, 12)),
    "time_hi_version": رقم("0x" + ه.جزء(12, 16)),
    "clock_seq_hi_variant": رقم("0x" + ه.جزء(16, 18)), "clock_seq_low": رقم("0x" + ه.جزء(18, 20)),
    "node": ه.جزء(20)
  }
}

// ───────── البايتات والأرقام ─────────
دالة الى_بايتات(س) { ارجع اساس.بايتات_من_hex(حلل(س)) }
دالة من_بايتات(ب) {
  اذا ب.طول != 16 { ارمي "UUID يتكون من 16 بايتاً بالضبط (وصل " + نص(ب.طول) + ")" }
  ارجع _قياسي(اساس.hex_من_بايتات(ب))
}
// صيغة GUID الخاصة بمايكروسوفت: الحقول الثلاثة الأولى بترتيب صغير الطرف
دالة الى_بايتات_le(س) {
  خل ه = حلل(س)
  خل ع = اساس.بايتات_من_hex(ه)
  ارجع [ع[3], ع[2], ع[1], ع[0], ع[5], ع[4], ع[7], ع[6]] + ع.جزء(8)
}
دالة من_بايتات_le(ب) {
  اذا ب.طول != 16 { ارمي "GUID يتكون من 16 بايتاً بالضبط" }
  ارجع من_بايتات([ب[3], ب[2], ب[1], ب[0], ب[5], ب[4], ب[7], ب[6]] + ب.جزء(8))
}
دالة الى_رقم(س) {
  خل ه = حلل(س)
  خل ق = "0"
  لكل ر في مدى(0, 4) {
    ق = ضخم.جمع(ضخم.ضرب(ق, "4294967296"), نص(رقم("0x" + ه.جزء(ر * 8, ر * 8 + 8))))
  }
  ارجع ق
}
دالة من_رقم(ن) {
  خل ق = ارقام_لاتينية(نص(ن)).نظف()
  اذا ق == "" او ليس اساس.هل_ارقام_عشرية(ق) { ارمي "الرقم يجب أن يكون عدداً صحيحاً غير سالب (نصاً)" }
  ق = اساس.ازل_اصفار_بادئة(ق)
  خل اجزاء = []
  لكل ر في مدى(0, 4) {
    اجزاء.اضف(اساس.hex_من_رقم(رقم(ضخم.باقي(ق, "4294967296")), 8))
    ق = ضخم.قسمة(ق, "4294967296")
  }
  اذا ق != "0" { ارمي "الرقم أكبر من 128 بت" }
  ارجع _قياسي(اجزاء.اعكس().ادمج(""))
}

// ───────── المقارنة والترتيب ─────────
// -1 / 0 / 1 بترتيب البايتات (وهو الترتيب الزمني الصحيح لـ v6 و v7)
دالة قارن_معرفات(م1, م2) {
  خل ه1 = حلل(م1); خل ه2 = حلل(م2)
  اذا ه1 == ه2 { ارجع 0 }
  ارجع ه1 < ه2 ? -1 : 1
}
دالة يتساوى(م1, م2) { ارجع حلل(م1) == حلل(م2) }
دالة رتب_معرفات(قائمة) {
  خل خ = قائمة.حول((س) => _قياسي(حلل(س)))
  خ.رتب((أ, ب) => أ < ب ? -1 : (أ > ب ? 1 : 0))
  ارجع خ
}

// ───────── بناء الإصدار والمتغير ─────────
دالة _ضع(ه, ن) {
  خل ف = (رقم("0x" + ه[16]) & 3) | 8
  ارجع ه.جزء(0, 12) + اساس.ابجدية_hex[ن] + ه.جزء(13, 16) + اساس.ابجدية_hex[ف] + ه.جزء(17)
}

// ───────── v4: عشوائي ─────────
دالة uuid4(خيارات = عدم) {
  خل ه = اساس.عشوائي_hex(16, اساس.خيار(خيارات, "عشوائي"))
  ارجع _قياسي(_ضع(ه, 4))
}

// ───────── v3 و v5: مبنية على الأسماء ─────────
دالة _فضاء(ف) {
  اذا نوع(ف) == "نص" و ف.صغير() في فضاءات { ارجع حلل(فضاءات[ف.صغير()]) }
  ارجع حلل(ف)
}
دالة uuid3(اسم, فضاء) {
  ارجع _قياسي(_ضع(md5.md5_hex(_فضاء(فضاء) + اساس.hex_من_نص(اسم)), 3))
}
دالة uuid3_بايتات(اسم_hex, فضاء) { ارجع _قياسي(_ضع(md5.md5_hex(_فضاء(فضاء) + اسم_hex), 3)) }
دالة uuid5(اسم, فضاء) {
  ارجع uuid5_بايتات(اساس.hex_من_نص(اسم), فضاء)
}
دالة uuid5_بايتات(اسم_hex, فضاء) {
  خل ه = تشفير.sha1(تشفير.فك_hex(_فضاء(فضاء) + اسم_hex))
  ارجع _قياسي(_ضع(ه.جزء(0, 32), 5))
}
// UUIDv8 مبني على SHA-256 (الطريقة التي يقترحها RFC 9562 للأسماء بدل SHA-1)
دالة uuid8_sha256(اسم, فضاء) {
  خل ه = تشفير.sha256(تشفير.فك_hex(_فضاء(فضاء) + اساس.hex_من_نص(اسم)))
  ارجع _قياسي(_ضع(ه.جزء(0, 32), 8))
}

// ───────── v1 و v6 (زمن غريغوري) و v2 (DCE) ─────────
خل _ساعة = {"مللي": 0, "كسر": 0, "تسلسل": عدم, "عقدة": عدم}

دالة _عقدة_عشوائية(مصدر) {
  خل ه = اساس.عشوائي_hex(6, مصدر)
  ارجع اساس.hex_من_رقم(رقم("0x" + ه.جزء(0, 2)) | 1, 2) + ه.جزء(2)   // بت البث المتعدد = 1 (RFC 9562 §6.10)
}
// ← [تكات 15 خانة، تسلسل الساعة 14 بت، العقدة 12 خانة]
دالة _زمن_غريغوري(خيارات) {
  خل مصدر = اساس.خيار(خيارات, "عشوائي")
  خل مللي = اساس.خيار(خيارات, "زمن")
  خل كسر = اساس.خيار(خيارات, "كسر")
  خل عقدة = اساس.خيار(خيارات, "عقدة")
  خل تسلسل = اساس.خيار(خيارات, "تسلسل")
  اذا عقدة == عدم {
    اذا _ساعة["عقدة"] == عدم { _ساعة["عقدة"] = _عقدة_عشوائية(مصدر) }
    عقدة = _ساعة["عقدة"]
  } والا {
    عقدة = ارقام_لاتينية(نص(عقدة)).صغير().ابدل(":", "").ابدل("-", "")
    اذا ليس اساس.هل_hex(عقدة, 12) { ارمي "العقدة يجب أن تكون 12 خانة hex (MAC)" }
  }
  اذا تسلسل == عدم {
    اذا _ساعة["تسلسل"] == عدم { _ساعة["تسلسل"] = اساس.عشوائي_صحيح(16384, مصدر) }
    تسلسل = _ساعة["تسلسل"]
  }
  اذا مللي == عدم {
    خل الان = اساس.الان_مللي()
    اذا الان > _ساعة["مللي"] {
      _ساعة["مللي"] = الان; _ساعة["كسر"] = 0
    } والا {
      _ساعة["كسر"] += 1
      اذا _ساعة["كسر"] >= 10000 { _ساعة["مللي"] += 1; _ساعة["كسر"] = 0 }
    }
    مللي = _ساعة["مللي"]; كسر = _ساعة["كسر"]
  }
  اذا كسر == عدم { كسر = 0 }
  اذا كسر < 0 او كسر >= 10000 { ارمي "الكسر بين 0 و 9999 (وحدة 100 نانوثانية)" }
  ارجع [اساس.تكات_من_مللي(مللي, كسر), تسلسل & 16383, عقدة]
}
دالة _تسلسل_hex(ت) { ارجع اساس.hex_من_رقم(32768 | ت, 4) }

دالة uuid1(خيارات = عدم) {
  خل ز = _زمن_غريغوري(خيارات)
  خل ت = ز[0]
  ارجع _قياسي(ت.جزء(7) + ت.جزء(3, 7) + "1" + ت.جزء(0, 3) + _تسلسل_hex(ز[1]) + ز[2])
}
// v6: نفس v1 لكن بحقول مرتبة زمنياً فيصلح للترتيب في قواعد البيانات
دالة uuid6(خيارات = عدم) {
  خل ز = _زمن_غريغوري(خيارات)
  خل ت = ز[0]
  ارجع _قياسي(ت.جزء(0, 8) + ت.جزء(8, 12) + "6" + ت.جزء(12, 15) + _تسلسل_hex(ز[1]) + ز[2])
}
// v2 (DCE Security): نطاق 0 مستخدم، 1 مجموعة، 2 منظمة
دالة uuid2(نطاق, معرف_محلي, خيارات = عدم) {
  اذا نطاق < 0 او نطاق > 255 { ارمي "النطاق بين 0 و 255" }
  خل ز = _زمن_غريغوري(خيارات)
  خل ت = ز[0]
  خل تس = اساس.hex_من_رقم(128 | ((ز[1] >> 8) & 63), 2)
  ارجع _قياسي(اساس.hex_من_رقم(معرف_محلي, 8) + ت.جزء(3, 7) + "2" + ت.جزء(0, 3) + تس + اساس.hex_من_رقم(نطاق, 2) + ز[2])
}
دالة v1_الى_v6(س) {
  خل ه = حلل(س)
  اذا ه[12] != "1" { ارمي "المعرّف ليس من الإصدار 1" }
  خل ت = ه.جزء(13, 16) + ه.جزء(8, 12) + ه.جزء(0, 8)
  ارجع _قياسي(ت.جزء(0, 8) + ت.جزء(8, 12) + "6" + ت.جزء(12, 15) + ه.جزء(16))
}
دالة v6_الى_v1(س) {
  خل ه = حلل(س)
  اذا ه[12] != "6" { ارمي "المعرّف ليس من الإصدار 6" }
  خل ت = ه.جزء(0, 8) + ه.جزء(8, 12) + ه.جزء(13, 16)
  ارجع _قياسي(ت.جزء(7) + ت.جزء(3, 7) + "1" + ت.جزء(0, 3) + ه.جزء(16))
}

// ───────── v7: زمني مرتب (الأفضل لمفاتيح قواعد البيانات) ─────────
خل _حالة7 = {"مللي": 0, "عداد": 0}
دالة v7_من_اجزاء(مللي, عشوائي_أ, عشوائي_ب_hex) {
  اذا مللي < 0 او مللي >= 281474976710656 { ارمي "الزمن خارج نطاق 48 بت" }
  خل ب = عشوائي_ب_hex
  ارجع _قياسي(اساس.hex_من_رقم(مللي, 12) + "7" + اساس.hex_من_رقم(عشوائي_أ & 4095, 3) + _ضع("0000000000000000" + ب, 7).جزء(16))
}
دالة uuid7(خيارات = عدم) {
  خل مصدر = اساس.خيار(خيارات, "عشوائي")
  خل صريح = اساس.خيار(خيارات, "زمن")
  اذا صريح != عدم {
    خل ر = اساس.عشوائي_hex(10, مصدر)
    ارجع v7_من_اجزاء(صريح, رقم("0x" + ر.جزء(0, 3)), ر.جزء(4, 20))
  }
  خل الان = اساس.الان_مللي()
  اذا الان > _حالة7["مللي"] {
    _حالة7["مللي"] = الان
    _حالة7["عداد"] = اساس.عشوائي_صحيح(33554432, مصدر)     // 25 بت: يترك مجالاً للزيادة داخل نفس المللي
  } والا {
    _حالة7["عداد"] += 1
    اذا _حالة7["عداد"] >= 67108864 { _حالة7["مللي"] += 1; _حالة7["عداد"] = اساس.عشوائي_صحيح(33554432, مصدر) }
  }
  خل ع = _حالة7["عداد"]
  خل ذيل = اساس.عشوائي_hex(6, مصدر)
  // 12 بت في rand_a + 14 بت في بداية rand_b (بعد بتي المتغير) = عداد 26 بت يضمن الترتيب
  خل ب = اساس.hex_من_رقم(32768 | (ع & 16383), 4) + ذيل
  ارجع _قياسي(اساس.hex_من_رقم(_حالة7["مللي"], 12) + "7" + اساس.hex_من_رقم(ع >> 14, 3) + ب)
}
// أصغر/أكبر UUIDv7 ممكن لزمن معين (لاستعلامات النطاق في قواعد البيانات)
دالة v7_حد(مللي, حد = "ادنى") {
  خل م = اساس.hex_من_رقم(مللي, 12)
  ارجع حد == "ادنى" ? _قياسي(م + "7000" + "8000000000000000") : _قياسي(م + "7fff" + "bfffffffffffffff")
}

// ───────── v8: مخصص ─────────
// من 16 بايتاً (hex أو قائمة) تُضبط عليها بتات الإصدار والمتغير فقط
دالة uuid8(بيانات = عدم, خيارات = عدم) {
  خل ه = عدم
  اذا بيانات == عدم { ه = اساس.عشوائي_hex(16, اساس.خيار(خيارات, "عشوائي")) }
  والا_اذا نوع(بيانات) == "قائمة" { ه = اساس.hex_من_بايتات(بيانات) }
  والا { ه = نص(بيانات).صغير() }
  اذا ليس اساس.هل_hex(ه, 32) { ارمي "v8 يحتاج 16 بايتاً بالضبط" }
  ارجع _قياسي(_ضع(ه, 8))
}

// ───────── الزمن المخزّن داخل المعرّف ─────────
// مللي ثانية يونكس لمعرفات v1 و v6 و v7 (وإلا عدم)
دالة زمن_معرف(س) {
  خل ه = حلل(س)
  خل ن = ه[12]
  اذا ن == "7" { ارجع رقم("0x" + ه.جزء(0, 12)) }
  اذا ن == "1" { ارجع اساس.مللي_من_تكات(ه.جزء(13, 16) + ه.جزء(8, 12) + ه.جزء(0, 8))[0] }
  اذا ن == "6" { ارجع اساس.مللي_من_تكات(ه.جزء(0, 8) + ه.جزء(8, 12) + ه.جزء(13, 16))[0] }
  ارجع عدم
}
// [مللي، كسر100ns] بدقة v1/v6 الكاملة
دالة زمن_دقيق(س) {
  خل ه = حلل(س)
  اذا ه[12] == "1" { ارجع اساس.مللي_من_تكات(ه.جزء(13, 16) + ه.جزء(8, 12) + ه.جزء(0, 8)) }
  اذا ه[12] == "6" { ارجع اساس.مللي_من_تكات(ه.جزء(0, 8) + ه.جزء(8, 12) + ه.جزء(13, 16)) }
  اذا ه[12] == "7" { ارجع [رقم("0x" + ه.جزء(0, 12)), 0] }
  ارجع عدم
}
// عقدة v1/v6
دالة عقدة_معرف(س) {
  خل ه = حلل(س)
  اذا ه[12] == "1" او ه[12] == "6" او ه[12] == "2" { ارجع ه.جزء(20) }
  ارجع عدم
}

// ───────── كائن UUID (على طريقة بايثون) ─────────
صنف معرف {
  بناء(س) { هذا._ه = حلل(س) }
  ساكن دالة من(س) { ارجع معرف(س) }
  ساكن دالة عشوائي() { ارجع معرف(uuid4()) }
  ساكن دالة زمني() { ارجع معرف(uuid7()) }
  ساكن دالة من_بايتات(ب) { ارجع معرف(من_بايتات(ب)) }
  خاصية hex() { ارجع هذا._ه }
  خاصية نسخة() { ارجع نسخة_من(هذا._ه) }
  خاصية متغير() { ارجع متغير_من(هذا._ه) }
  خاصية urn() { ارجع "urn:uuid:" + _قياسي(هذا._ه) }
  خاصية رقم_كبير() { ارجع الى_رقم(هذا._ه) }
  خاصية بايتات() { ارجع الى_بايتات(هذا._ه) }
  خاصية حقول() { ارجع حقول(هذا._ه) }
  خاصية زمن() { ارجع زمن_معرف(هذا._ه) }
  خاصية فارغ() { ارجع هذا._ه == "00000000000000000000000000000000" }
  نص() { ارجع _قياسي(هذا._ه) }
  نسق(صيغة = "قياسي") { ارجع نسق_معرف(هذا._ه, صيغة) }
  يساوي(آخر) { ارجع هذا._ه == حلل(نوع(آخر) == "معرف" ? آخر.hex : آخر) }
  قارن(آخر) { ارجع قارن_معرفات(هذا._ه, نوع(آخر) == "معرف" ? آخر.hex : آخر) }
}
