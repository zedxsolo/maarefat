// رموز.سو — رموز مقروءة للبشر (دعوات، قسائم، أكواد تفعيل) بحرف تحقق Luhn mod N يكشف أخطاء الطباعة
استورد "./اساس"
استورد "./nanoid"

// حرف التحقق (خوارزمية Luhn mod N العامة لأي أبجدية)
دالة حرف_تحقق(س, ابجدية) {
  خل ح = ابجدية.حروف(); خل ن = ح.طول
  خل عامل = 2; خل مجموع = 0
  لكل ي في مدى(س.طول - 1, -1, -1) {
    خل ق = ح.ابحث(س[ي])
    اذا ق == -1 { ارمي "حرف خارج الأبجدية: " + س[ي] }
    خل اضافة = عامل * ق
    عامل = عامل == 2 ? 1 : 2
    مجموع += (اضافة \ ن) + (اضافة % ن)
  }
  ارجع ح[(ن - (مجموع % ن)) % ن]
}
دالة _ابجدية(ا) {
  اذا ا == عدم { ارجع nanoid.ابجديات["مقروء"] }
  اذا نوع(ا) == "نص" و ا في nanoid.ابجديات { ارجع nanoid.ابجديات[ا] }
  ارجع ا
}
دالة _جمّع(س, كل, فاصل) {
  اذا كل <= 0 { ارجع س }
  خل خ = []
  خل ي = 0
  طالما ي < س.طول { خ.اضف(س.جزء(ي, ي + كل)); ي += كل }
  ارجع خ.ادمج(فاصل)
}
// خيارات: ابجدية ("مقروء" افتراضياً)، فاصل_كل (4)، فاصل ("-")، فحص (صح)، بادئة ("")، عشوائي
دالة رمز(طول = 8, خيارات = عدم) {
  خل ا = _ابجدية(اساس.خيار(خيارات, "ابجدية"))
  خل ج = nanoid.جديد(طول, ا, خيارات)
  اذا اساس.خيار(خيارات, "فحص", صح) { ج += حرف_تحقق(ج, ا) }
  خل ر = _جمّع(ج, اساس.خيار(خيارات, "فاصل_كل", 4), اساس.خيار(خيارات, "فاصل", "-"))
  خل ب = اساس.خيار(خيارات, "بادئة", "")
  ارجع ب == "" ? ر : ب + اساس.خيار(خيارات, "فاصل", "-") + ر
}
// يتحقق من الرمز (يتجاهل الفواصل والفراغات وحالة الأحرف إن كانت الأبجدية كبيرة فقط)
دالة هل_رمز_صالح(س, خيارات = عدم) {
  خل ا = _ابجدية(اساس.خيار(خيارات, "ابجدية"))
  خل ق = نص(س).ابدل(اساس.خيار(خيارات, "فاصل", "-"), "").ابدل(" ", "")
  اذا ق.كبير() != ق.صغير() و ا.كبير() == ا { ق = ق.كبير() }
  اذا ق.طول < 2 { ارجع غلط }
  لكل ح في ق.حروف() { اذا ليس (ح في ا) { ارجع غلط } }
  ارجع حرف_تحقق(ق.جزء(0, ق.طول - 1), ا) == ق[ق.طول - 1]
}
دالة رمز_دعوة() { ارجع رمز(8, {"فاصل_كل": 3}) }
// رمز رقمي (مثل رمز التحقق عبر الرسائل) بأصفار بادئة محفوظة
دالة رمز_رقمي(ن = 6, خيارات = عدم) { ارجع nanoid.جديد(ن, "ارقام", خيارات) }
