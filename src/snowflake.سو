// snowflake.سو — Snowflake: رقم 64 بت = زمن (مللي منذ حقبة) | رقم العقدة | تسلسل. يُعاد نصاً عشرياً (لأن 64 بت لا تتسع في double).
استورد "ضخم"
استورد "./اساس"

// الأنماط الجاهزة: بتات العقدة والتسلسل وحقبة الزمن
خل انماط = {
  "تويتر": {"حقبة": 1288834974657, "بتات_عقدة": 10, "بتات_تسلسل": 12},
  "ديسكورد": {"حقبة": 1420070400000, "بتات_عقدة": 10, "بتات_تسلسل": 12},
  "انستغرام": {"حقبة": 1314220021721, "بتات_عقدة": 13, "بتات_تسلسل": 10},
  "ساعة_يونكس": {"حقبة": 0, "بتات_عقدة": 10, "بتات_تسلسل": 12}
}

دالة _اعدادات(خيارات) {
  خل نمط = اساس.خيار(خيارات, "نمط", "تويتر")
  اذا ليس (نمط في انماط) { ارمي "نمط غير معروف: " + نص(نمط) }
  خل ن = انماط[نمط]
  خل ح = اساس.خيار(خيارات, "حقبة", ن["حقبة"])
  خل بع = اساس.خيار(خيارات, "بتات_عقدة", ن["بتات_عقدة"])
  خل بت = اساس.خيار(خيارات, "بتات_تسلسل", ن["بتات_تسلسل"])
  اذا بع + بت > 22 او بع < 0 او بت < 1 { ارمي "بتات العقدة + التسلسل يجب ألا تتجاوز 22 (وإلا تفيض 64 بت مع زمن 41 بت)" }
  ارجع {"حقبة": ح, "بع": بع, "بت": بت, "ازاحة": 2 ** (بع + بت)}
}

// مولّد: ينشئ كائناً بحالة (آخر زمن وتسلسل)، لكل عقدة مولّد واحد
صنف مولد_سنوفليك {
  بناء(عقدة, خيارات = عدم) {
    هذا._ع = _اعدادات(خيارات)
    اذا عقدة < 0 او عقدة >= 2 ** هذا._ع["بع"] { ارمي "رقم العقدة يجب أن يكون بين 0 و " + نص(2 ** هذا._ع["بع"] - 1) }
    هذا._عقدة = عقدة
    هذا._اخر = -1
    هذا._تسلسل = 0
  }
  جديد(زمن_صريح = عدم) {
    خل ع = هذا._ع
    خل الان = زمن_صريح == عدم ? اساس.الان_مللي() : زمن_صريح
    اذا الان < ع["حقبة"] { ارمي "الزمن قبل الحقبة" }
    اذا الان <= هذا._اخر {
      // الساعة لم تتقدم (أو رجعت): نكمل على آخر زمن ونزيد التسلسل حتى لا يتكرر المعرّف
      الان = هذا._اخر
      هذا._تسلسل += 1
      اذا هذا._تسلسل >= 2 ** ع["بت"] { الان += 1; هذا._تسلسل = 0 }
    } والا { هذا._تسلسل = 0 }
    هذا._اخر = الان
    خل منخفض = هذا._عقدة * (2 ** ع["بت"]) + هذا._تسلسل
    ارجع ضخم.جمع(ضخم.ضرب(نص(الان - ع["حقبة"]), نص(ع["ازاحة"])), نص(منخفض))
  }
}
دالة مولد_جديد(عقدة = 0, خيارات = عدم) { ارجع مولد_سنوفليك(عقدة, خيارات) }

// فك معرّف: {زمن (مللي يونكس), عقدة, تسلسل}
دالة فك(معرف_نص, خيارات = عدم) {
  خل ع = _اعدادات(خيارات)
  خل ق = ارقام_لاتينية(نص(معرف_نص)).نظف()
  اذا ليس اساس.هل_ارقام_عشرية(ق) { ارمي "Snowflake يجب أن يكون رقماً عشرياً (نصاً)" }
  خل ز = رقم(ضخم.قسمة(ق, نص(ع["ازاحة"])))
  خل م = رقم(ضخم.باقي(ق, نص(ع["ازاحة"])))
  خل قسمة_تسلسل = 2 ** ع["بت"]
  خل ن = م \ قسمة_تسلسل
  ارجع {"زمن": ز + ع["حقبة"], "عقدة": ن, "تسلسل": م % قسمة_تسلسل}
}
دالة زمن_من(معرف_نص, خيارات = عدم) { ارجع فك(معرف_نص, خيارات)["زمن"] }
// ديسكورد يقسم العقدة إلى عامل (5 بت) وعملية (5 بت)
دالة فك_ديسكورد(معرف_نص) {
  خل ن = فك(معرف_نص, {"نمط": "ديسكورد"})
  ارجع {"زمن": ن["زمن"], "عامل": ن["عقدة"] >> 5, "عملية": ن["عقدة"] & 31, "تسلسل": ن["تسلسل"]}
}
