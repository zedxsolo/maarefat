// sqids.سو — Sqids: يحوّل أرقاماً صحيحة (مفاتيح قواعد بيانات مثلاً) إلى معرّف قصير غير متسلسل، وفكّه بلا جدول.
// ليس تشفيراً: لا تعتمد عليه لإخفاء بيانات حساسة. خوارزمية متوافقة مع sqids.org (بلا قائمة حظر افتراضية).
استورد "./اساس"

خل ابجدية_افتراضية = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

دالة _كود(ح) { ارجع رمز(ح) }
دالة _خلط(ح) {
  خل ن = ح.طول
  خل ي = 0; خل ج = ن - 1
  طالما ج > 0 {
    خل ر = (ي * ج + _كود(ح[ي]) + _كود(ح[ج])) % ن
    خل ت = ح[ي]; ح[ي] = ح[ر]; ح[ر] = ت
    ي += 1; ج -= 1
  }
  ارجع ح
}
دالة _الى_معرف(رقم_ن, ح) {
  خل خ = []
  خل ق = رقم_ن
  خل ن = ح.طول
  طالما صح {
    خ.اضف(ح[ق % ن])
    ق = ق \ ن
    اذا ق == 0 { توقف }
  }
  ارجع خ.اعكس().ادمج("")
}
دالة _الى_رقم(س, ح) {
  خل ن = ح.طول
  خل ق = 0
  لكل ك في س.حروف() { ق = ق * ن + ح.ابحث(ك) }
  ارجع ق
}

صنف سكيدز {
  بناء(خيارات = عدم) {
    خل ا = اساس.خيار(خيارات, "ابجدية", ابجدية_افتراضية)
    اذا ا.طول < 3 { ارمي "الأبجدية 3 حروف على الأقل" }
    اذا ا.حروف().فريد().طول != ا.طول { ارمي "الأبجدية فيها حروف مكررة" }
    هذا._ابجدية = _خلط(ا.حروف())
    هذا._اقل_طول = اساس.خيار(خيارات, "اقل_طول", 0)
    هذا._حظر = اساس.خيار(خيارات, "قائمة_حظر", []).حول((ك) => ك.صغير())
  }
  _محظور(معرف_ن) {
    خل ص = معرف_ن.صغير()
    لكل ك في هذا._حظر {
      اذا ك.طول > ص.طول { استمر }
      خل فيه_رقم = غلط
      لكل ح في ك.حروف() { اذا ح >= "0" و ح <= "9" { فيه_رقم = صح } }
      اذا ص.طول <= 3 او ك.طول <= 3 { اذا ص == ك { ارجع صح } }
      والا_اذا فيه_رقم { اذا ص.يبدأ_ب(ك) او ص.ينتهي_ب(ك) { ارجع صح } }
      والا_اذا ص.يحتوي(ك) { ارجع صح }
    }
    ارجع غلط
  }
  _رمز(اعداد, زيادة) {
    خل ح = هذا._ابجدية
    خل ن = ح.طول
    اذا زيادة > ن { ارمي "تعذّر توليد معرّف غير محظور" }
    خل ازاحة = اعداد.طول
    لكل ي في مدى(0, اعداد.طول) { ازاحة += _كود(ح[اعداد[ي] % ن]) + ي }
    ازاحة = (ازاحة % ن + زيادة) % ن
    خل ا = ح.جزء(ازاحة) + ح.جزء(0, ازاحة)
    خل بادئة = ا[0]
    ا = ا.انسخ().اعكس()
    خل خ = [بادئة]
    لكل ي في مدى(0, اعداد.طول) {
      خ.اضف(_الى_معرف(اعداد[ي], ا.جزء(1)))
      اذا ي < اعداد.طول - 1 {
        خ.اضف(ا[0])
        ا = _خلط(ا)
      }
    }
    خل معرف_ن = خ.ادمج("")
    اذا هذا._اقل_طول > معرف_ن.طول {
      معرف_ن += ا[0]
      طالما هذا._اقل_طول - معرف_ن.طول > 0 {
        ا = _خلط(ا)
        معرف_ن += ا.جزء(0, هذا._اقل_طول - معرف_ن.طول).ادمج("")
      }
    }
    اذا هذا._محظور(معرف_ن) { ارجع هذا._رمز(اعداد, زيادة + 1) }
    ارجع معرف_ن
  }
  ترميز(اعداد) {
    اذا اعداد.طول == 0 { ارجع "" }
    لكل ر في اعداد {
      اذا نوع(ر) != "رقم" او ر < 0 او ر != رياضيات_ارضي(ر) او ر > 9007199254740991 { ارمي "Sqids يقبل أعداداً صحيحة بين 0 و 2^53-1 فقط" }
    }
    ارجع هذا._رمز(اعداد, 0)
  }
  فك(معرف_ن) {
    خل خ = []
    اذا معرف_ن == "" { ارجع خ }
    خل ح = هذا._ابجدية
    لكل ك في معرف_ن.حروف() { اذا ح.ابحث(ك) == -1 { ارجع خ } }
    خل ازاحة = ح.ابحث(معرف_ن[0])
    خل ا = ح.جزء(ازاحة) + ح.جزء(0, ازاحة)
    ا = ا.انسخ().اعكس()
    خل بقية = معرف_ن.جزء(1)
    طالما بقية.طول > 0 {
      خل فاصل = ا[0]
      خل اجزاء = بقية.قسم(فاصل)
      اذا اجزاء[0] == "" { ارجع خ }
      خ.اضف(_الى_رقم(اجزاء[0], ا.جزء(1)))
      اذا اجزاء.طول > 1 { ا = _خلط(ا) }
      بقية = اجزاء.جزء(1).ادمج(فاصل)
    }
    ارجع خ
  }
}
دالة رياضيات_ارضي(ر) { ارجع ر - (ر % 1) }
دالة جديد(خيارات = عدم) { ارجع سكيدز(خيارات) }
