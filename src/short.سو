// short.سو — تقصير UUID إلى 22 حرفاً (أو غيرها) وإعادته، بأي أبجدية
استورد "رياضيات"
استورد "./اساس"
استورد "./uuid"

خل ابجديات = {
  "فليكر58": اساس.ابجدية_فليكر58, "base58": اساس.ابجدية_base58, "base62": اساس.ابجدية_base62,
  "base36": اساس.ابجدية_base36, "base64url": اساس.ابجدية_base64url, "كروكفورد": اساس.ابجدية_كروكفورد
}
دالة _ابجدية(ا) {
  اذا نوع(ا) == "نص" و ا في ابجديات { ارجع ابجديات[ا] }
  ارجع ا
}
// أقل عدد حروف يتسع لـ 128 بت في هذه الأبجدية (طول ثابت: يحافظ على الترتيب الأبجدي = ترتيب الأرقام)
دالة طول_ثابت(ابجدية = "فليكر58") { ارجع رياضيات.سقف(128 / (رياضيات.لوغ(_ابجدية(ابجدية).طول) / رياضيات.لوغ(2))) }
دالة قصير(معرف_uuid, ابجدية = "فليكر58") {
  خل ا = _ابجدية(ابجدية)
  ارجع اساس.hex_الى_قاعدة(uuid.حلل(معرف_uuid), ا, طول_ثابت(ا))
}
دالة طويل(نص_قصير, ابجدية = "فليكر58") {
  خل ا = _ابجدية(ابجدية)
  اذا نص_قصير.طول != طول_ثابت(ا) { ارمي "الطول غير صحيح: المتوقع " + نص(طول_ثابت(ا)) + " حرفاً" }
  ارجع uuid.قياسي(اساس.قاعدة_الى_hex(نص_قصير, ا, 16))
}
// UUIDv4 جديد بصيغة قصيرة، وuuidv7 قصير قابل للترتيب
دالة جديد(ابجدية = "فليكر58") { ارجع قصير(uuid.uuid4(), ابجدية) }
دالة جديد_زمني(ابجدية = "فليكر58") { ارجع قصير(uuid.uuid7(), ابجدية) }
