// اختبارات النواة (src/اساس.سو) — تشغيل: solan tests/اساس_اختبار.سو
استورد "اختبار"
استورد "../src/اساس" باسم س

اختبار.مجموعة("اساس: hex والأرقام", دالة() {
  اختبار.اختبر("hex ذهاب وإياب", دالة() {
    اختبار.يساوي(س.hex_من_بايتات([0, 15, 16, 255]), "000f10ff")
    اختبار.يساوي(س.بايتات_من_hex("000F10ff"), [0, 15, 16, 255])
    اختبار.يساوي(س.بايتات_من_hex(""), [])
    اختبار.يرمي(() => س.بايتات_من_hex("abc"))
    اختبار.يرمي(() => س.بايتات_من_hex("zz"))
  })
  اختبار.اختبر("hex_من_رقم: حشو وفيض", دالة() {
    اختبار.يساوي(س.hex_من_رقم(255, 4), "00ff")
    اختبار.يساوي(س.hex_من_رقم(0, 2), "00")
    اختبار.يرمي(() => س.hex_من_رقم(256, 2))
    اختبار.يرمي(() => س.hex_من_رقم(-1, 2))
  })
  اختبار.اختبر("hex_من_نص يرمّز UTF-8", دالة() {
    اختبار.يساوي(س.hex_من_نص("abc"), "616263")
    اختبار.يساوي(س.hex_من_نص("س"), "d8b3")
  })
  اختبار.اختبر("هل_hex والأرقام العشرية", دالة() {
    اختبار.هو_صح(س.هل_hex("00ff", 4)); اختبار.هو_غلط(س.هل_hex("00ff", 3)); اختبار.هو_غلط(س.هل_hex(""))
    اختبار.هو_صح(س.هل_ارقام_عشرية("0123")); اختبار.هو_غلط(س.هل_ارقام_عشرية("12a")); اختبار.هو_غلط(س.هل_ارقام_عشرية(5))
    اختبار.يساوي(س.ازل_اصفار_بادئة("00120"), "120"); اختبار.يساوي(س.ازل_اصفار_بادئة("000"), "0")
  })
})

اختبار.مجموعة("اساس: الأساسات والتكات", دالة() {
  اختبار.اختبر("تحويل الأساس مع طول ثابت وذهاب وإياب", دالة() {
    اختبار.يساوي(س.hex_الى_قاعدة("ff", "0123456789"), "255")
    اختبار.يساوي(س.hex_الى_قاعدة("00", "0123456789", 4), "0000")
    اختبار.يساوي(س.قاعدة_الى_hex("255", "0123456789", 2), "00ff")
    خل ه = "b5a1cd34b5f99d1154fb6853345c9735"
    اختبار.يساوي(س.قاعدة_الى_hex(س.hex_الى_قاعدة(ه, س.ابجدية_base62, 22), س.ابجدية_base62, 16), ه)
  })
  اختبار.اختبر("الفيض والحرف غير الصالح يُرفضان", دالة() {
    اختبار.يرمي(() => س.قاعدة_الى_hex("256", "0123456789", 1))
    اختبار.يرمي(() => س.قاعدة_الى_hex("12x", "0123456789", 2))
    اختبار.يرمي(() => س.hex_الى_قاعدة("ff", "aab"))
  })
  اختبار.اختبر("تكات UUID: متجه RFC 9562 وذهاب وإياب", دالة() {
    اختبار.يساوي(س.تكات_من_مللي(1645557742000, 0), "1ec9414c232ab00")
    اختبار.يساوي(س.مللي_من_تكات("1ec9414c232ab00"), [1645557742000, 0])
    لكل ك في [0, 1, 4999, 9999] {
      اختبار.يساوي(س.مللي_من_تكات(س.تكات_من_مللي(1700000000123, ك)), [1700000000123, ك])
    }
  })
  اختبار.اختبر("base64url بلا حشو", دالة() {
    خل ه = "886313e13b8a53729b900c9aee199e5d"
    اختبار.يساوي(س.base64url_من_hex(ه).طول, 22)
    اختبار.يساوي(س.hex_من_base64url(س.base64url_من_hex(ه)), ه)
    اختبار.يرمي(() => س.hex_من_base64url("a+b"))
  })
  اختبار.اختبر("زمن_iso", دالة() {
    اختبار.يساوي(س.زمن_iso(1645557742000), "2022-02-22T19:22:22.000Z")
    اختبار.يساوي(س.زمن_iso(1700000000123), "2023-11-14T22:13:20.123Z")
  })
})

اختبار.مجموعة("اساس: العشوائية", دالة() {
  اختبار.اختبر("الطول والحد", دالة() {
    اختبار.يساوي(س.عشوائي_hex(8).طول, 16)
    اختبار.يساوي(س.عشوائي_بايتات(5).طول, 5)
    لكل ر في مدى(0, 500) { اختبار.هو_صح(س.عشوائي_صحيح(7) < 7) }
    اختبار.يساوي(س.عشوائي_صحيح(1), 0)
    اختبار.يرمي(() => س.عشوائي_صحيح(0))
  })
  اختبار.اختبر("البذرة حتمية ومختلفة بين البذور", دالة() {
    اختبار.يساوي(س.مولد_بذرة("أ")(40), س.مولد_بذرة("أ")(40))
    اختبار.لا_يساوي(س.مولد_بذرة(1)(16), س.مولد_بذرة(2)(16))
    اختبار.يساوي(س.مولد_بذرة(1)(40).طول, 80)
  })
  اختبار.اختبر("المصدر المخصص: الأولوية والتحقق والإعادة", دالة() {
    اختبار.يساوي(س.عشوائي_hex(2, (ن) => "ab" * ن), "abab")
    س.ضبط_المصدر((ن) => "01" * ن)
    اختبار.يساوي(س.عشوائي_hex(3), "010101")
    اختبار.يساوي(س.عشوائي_hex(3, (ن) => "02" * ن), "020202")
    س.اعد_المصدر_الافتراضي()
    اختبار.لا_يساوي(س.عشوائي_hex(8), "0101010101010101")
    اختبار.يرمي(() => س.عشوائي_hex(2, (ن) => "ab"))
  })
})

اختبار.شغل_الكل()
