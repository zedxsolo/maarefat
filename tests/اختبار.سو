// اختبارات مكتبة معرفات — تشغيل: solan tests/اختبار.سو
استورد "اختبار"
استورد "ضخم"
استورد "../رئيسي" باسم م

دالة _مرتب(ق) {
  خل ن = ق.انسخ(); ن.رتب((أ, ب) => أ < ب ? -1 : (أ > ب ? 1 : 0))
  ارجع ن == ق
}
خل ثابت_dns = "dns"

اختبار.مجموعة("UUID — متجهات RFC 9562 والمراجع المعروفة", دالة() {
  اختبار.اختبر("v3 (MD5) لاسم www.example.com", دالة() { اختبار.يساوي(م.uuid3("www.example.com", ثابت_dns), "5df41881-3aed-3515-88a7-2f4a814cf09e") })
  اختبار.اختبر("v5 (SHA-1) لاسم www.example.com", دالة() { اختبار.يساوي(م.uuid5("www.example.com", ثابت_dns), "2ed6657d-e927-568b-95e1-2665a8aea6a2") })
  اختبار.اختبر("v5 لاسم python.org", دالة() { اختبار.يساوي(م.uuid5("python.org", "dns"), "886313e1-3b8a-5372-9b90-0c9aee199e5d") })
  اختبار.اختبر("v5 يقبل UUID مخصصاً كفضاء", دالة() { اختبار.يساوي(م.uuid5("python.org", "6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "886313e1-3b8a-5372-9b90-0c9aee199e5d") })
  اختبار.اختبر("v1 (متجه RFC)", دالة() {
    اختبار.يساوي(م.uuid1({"زمن": 1645557742000, "تسلسل": 13256, "عقدة": "9F6BDECED846"}), "c232ab00-9414-11ec-b3c8-9f6bdeced846")
  })
  اختبار.اختبر("v6 (متجه RFC)", دالة() {
    اختبار.يساوي(م.uuid6({"زمن": 1645557742000, "تسلسل": 13256, "عقدة": "9F6BDECED846"}), "1ec9414c-232a-6b00-b3c8-9f6bdeced846")
  })
  اختبار.اختبر("v7 (متجه RFC)", دالة() {
    اختبار.يساوي(م.وحدات["uuid"].v7_من_اجزاء(0x017F22E279B0, 0xCC3, "18c4dc0c0c07398f"), "017f22e2-79b0-7cc3-98c4-dc0c0c07398f")
  })
  اختبار.اختبر("v1 ↔ v6", دالة() {
    اختبار.يساوي(م.v1_الى_v6("c232ab00-9414-11ec-b3c8-9f6bdeced846"), "1ec9414c-232a-6b00-b3c8-9f6bdeced846")
    اختبار.يساوي(م.v6_الى_v1("1ec9414c-232a-6b00-b3c8-9f6bdeced846"), "c232ab00-9414-11ec-b3c8-9f6bdeced846")
  })
  اختبار.اختبر("استخراج الزمن من v1 وv6 وv7", دالة() {
    اختبار.يساوي(م.زمن_معرف("c232ab00-9414-11ec-b3c8-9f6bdeced846"), 1645557742000)
    اختبار.يساوي(م.زمن_معرف("1ec9414c-232a-6b00-b3c8-9f6bdeced846"), 1645557742000)
    اختبار.يساوي(م.زمن_معرف("017f22e2-79b0-7cc3-98c4-dc0c0c07398f"), 0x017F22E279B0)
    اختبار.هو_عدم(م.زمن_معرف(م.uuid4()))
  })
  اختبار.اختبر("v4: الشكل والإصدار والمتغير", دالة() {
    لكل ر في مدى(0, 200) {
      خل ع = م.uuid4()
      اختبار.يساوي(ع.طول, 36)
      اختبار.يساوي(م.نسخة_uuid(ع), 4)
      اختبار.يساوي(م.متغير_uuid(ع), "rfc9562")
      اختبار.هو_صح(م.هل_uuid(ع, 4))
    }
  })
  اختبار.اختبر("v1 تضع بت البث المتعدد في العقدة العشوائية", دالة() {
    خل ع = م.uuid1()
    اختبار.يساوي(رقم("0x" + ع.جزء(24, 26)) & 1, 1)
  })
  اختبار.اختبر("v2 يضع النطاق والمعرف المحلي", دالة() {
    خل ع = م.uuid2(1, 1000)
    اختبار.يساوي(م.نسخة_uuid(ع), 2)
    اختبار.يساوي(ع.جزء(0, 8), "000003e8")
    اختبار.يساوي(ع.جزء(21, 23), "01")
  })
  اختبار.اختبر("v7: ترتيب زمني صارم حتى داخل نفس المللي ثانية", دالة() {
    خل ق = م.دفعة(() => م.uuid7(), 3000)
    اختبار.هو_صح(_مرتب(ق))
    اختبار.يساوي(ق.فريد().طول, 3000)
  })
  اختبار.اختبر("v6 مرتب وv1 فريد", دالة() {
    اختبار.هو_صح(_مرتب(م.دفعة(() => م.uuid6(), 500)))
    اختبار.يساوي(م.دفعة(() => م.uuid1(), 500).فريد().طول, 500)
  })
  اختبار.اختبر("v7 بزمن صريح", دالة() {
    خل ع = م.uuid7({"زمن": 1700000000000})
    اختبار.يساوي(م.زمن_معرف(ع), 1700000000000)
    اختبار.يساوي(م.نسخة_uuid(ع), 7)
  })
  اختبار.اختبر("v7_حد لاستعلامات النطاق", دالة() {
    خل ادنى = م.v7_حد(1700000000000); خل اقصى = م.v7_حد(1700000000000, "اقصى")
    خل ع = م.uuid7({"زمن": 1700000000000})
    اختبار.هو_صح(ادنى <= ع); اختبار.هو_صح(ع <= اقصى)
    اختبار.هو_صح(م.v7_حد(1700000000001) > اقصى)
  })
  اختبار.اختبر("v8", دالة() {
    اختبار.يساوي(م.نسخة_uuid(م.uuid8()), 8)
    اختبار.يساوي(م.uuid8("00112233445566778899aabbccddeeff"), "00112233-4455-8677-8899-aabbccddeeff")
    اختبار.يساوي(م.نسخة_uuid(م.uuid8_sha256("x", "dns")), 8)
    اختبار.يرمي(() => م.uuid8("1234"))
  })
  اختبار.اختبر("nil وmax", دالة() {
    اختبار.يساوي(م.NIL, "00000000-0000-0000-0000-000000000000")
    اختبار.يساوي(م.MAX, "ffffffff-ffff-ffff-ffff-ffffffffffff")
    اختبار.هو_صح(م.هل_uuid(م.NIL)); اختبار.هو_غلط(م.هل_uuid(م.NIL, 4))
  })
})

اختبار.مجموعة("UUID — التحليل والصيغ والمقارنة", دالة() {
  خل ع = "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
  اختبار.اختبر("يقبل كل الصيغ", دالة() {
    اختبار.يساوي(م.حلل_uuid("{6BA7B810-9DAD-11D1-80B4-00C04FD430C8}"), "6ba7b8109dad11d180b400c04fd430c8")
    اختبار.يساوي(م.حلل_uuid("urn:uuid:" + ع), "6ba7b8109dad11d180b400c04fd430c8")
    اختبار.يساوي(م.حلل_uuid("6ba7b8109dad11d180b400c04fd430c8"), "6ba7b8109dad11d180b400c04fd430c8")
    اختبار.يساوي(م.حلل_uuid("  " + ع + " "), "6ba7b8109dad11d180b400c04fd430c8")
  })
  اختبار.اختبر("يقبل الأرقام الهندية", دالة() {
    اختبار.يساوي(م.حلل_uuid(ارقام_عربية(ع)), "6ba7b8109dad11d180b400c04fd430c8")
    اختبار.هو_صح(م.هل_uuid(م.نسق_معرف(ع, "هندي")))
  })
  اختبار.اختبر("يرفض غير الصالح", دالة() {
    لكل س في ["", "abc", "6ba7b810-9dad-11d1-80b4-00c04fd430c", "6ba7b810-9dad-11d1-80b4-00c04fd430cZ", "6ba7b8109-dad-11d1-80b4-00c04fd430c8", عدم, 42] {
      اختبار.هو_غلط(م.هل_uuid(س))
    }
    اختبار.يرمي(() => م.حلل_uuid("غير صالح"))
  })
  اختبار.اختبر("فحص الإصدار والمتغير صارماً", دالة() {
    اختبار.هو_غلط(م.هل_uuid("6ba7b810-9dad-91d1-80b4-00c04fd430c8"))                // الإصدار 9
    اختبار.هو_صح(م.هل_uuid("6ba7b810-9dad-91d1-80b4-00c04fd430c8", عدم, غلط))     // غير صارم
    اختبار.هو_غلط(م.هل_uuid("6ba7b810-9dad-11d1-c0b4-00c04fd430c8"))                // متغير مايكروسوفت
    اختبار.يساوي(م.متغير_uuid("6ba7b810-9dad-11d1-c0b4-00c04fd430c8"), "microsoft")
  })
  اختبار.اختبر("الصيغ", دالة() {
    اختبار.يساوي(م.نسق_معرف(ع, "بسيط"), "6ba7b8109dad11d180b400c04fd430c8")
    اختبار.يساوي(م.نسق_معرف(ع, "اقواس"), "{" + ع + "}")
    اختبار.يساوي(م.نسق_معرف(ع, "كبير"), ع.كبير())
    اختبار.يساوي(م.نسق_معرف(ع, "urn"), "urn:uuid:" + ع)
    اختبار.يساوي(م.نسق_معرف(ع, "مختصر").طول, 22)
    اختبار.يرمي(() => م.نسق_معرف(ع, "غريب"))
  })
  اختبار.اختبر("ذهاب وإياب في كل التمثيلات", دالة() {
    لكل ر في مدى(0, 50) {
      خل ك = م.uuid4()
      اختبار.يساوي(م.وحدات["uuid"].من_مختصر(م.نسق_معرف(ك, "مختصر")), ك)
      اختبار.يساوي(م.وحدات["uuid"].من_base58(م.نسق_معرف(ك, "base58")), ك)
      اختبار.يساوي(م.وحدات["uuid"].من_base62(م.نسق_معرف(ك, "base62")), ك)
      اختبار.يساوي(م.وحدات["uuid"].من_بايتات(م.وحدات["uuid"].الى_بايتات(ك)), ك)
      اختبار.يساوي(م.وحدات["uuid"].من_بايتات_le(م.وحدات["uuid"].الى_بايتات_le(ك)), ك)
      اختبار.يساوي(م.وحدات["uuid"].من_رقم(م.وحدات["uuid"].الى_رقم(ك)), ك)
    }
  })
  اختبار.اختبر("الرقم العشري الكامل", دالة() {
    اختبار.يساوي(م.وحدات["uuid"].الى_رقم(م.MAX), "340282366920938463463374607431768211455")
    اختبار.يساوي(م.وحدات["uuid"].الى_رقم(م.NIL), "0")
    اختبار.يساوي(م.وحدات["uuid"].من_رقم("1"), "00000000-0000-0000-0000-000000000001")
  })
  اختبار.اختبر("GUID بترتيب مايكروسوفت", دالة() {
    اختبار.يساوي(م.وحدات["uuid"].الى_بايتات_le("00112233-4455-6677-8899-aabbccddeeff"), [51, 34, 17, 0, 85, 68, 119, 102, 136, 153, 170, 187, 204, 221, 238, 255])
  })
  اختبار.اختبر("المقارنة والترتيب", دالة() {
    اختبار.يساوي(م.قارن_معرفات(م.NIL, م.MAX), -1)
    اختبار.يساوي(م.قارن_معرفات(م.MAX, م.NIL), 1)
    اختبار.يساوي(م.قارن_معرفات(ع, ع.كبير()), 0)
    اختبار.يساوي(م.رتب_معرفات([م.MAX, م.NIL, ع]), [م.NIL, ع, م.MAX])
  })
  اختبار.اختبر("كائن معرف", دالة() {
    خل ك = م.معرف.من(ع)
    اختبار.يساوي(ك.نص(), ع); اختبار.يساوي(ك.نسخة, 1); اختبار.يساوي(ك.urn, "urn:uuid:" + ع)
    اختبار.هو_صح(ك.يساوي(ع.كبير())); اختبار.يساوي(ك.حقول["node"], "00c04fd430c8")
    اختبار.يساوي(م.معرف.عشوائي().نسخة, 4)
  })
})

اختبار.مجموعة("العشوائية الحتمية", دالة() {
  اختبار.اختبر("نفس البذرة تعطي نفس المعرفات", دالة() {
    م.ضبط_المصدر(م.مولد_بذرة("بذرة"))
    خل أ = [م.uuid4(), م.nanoid(10), م.ulid({"زمن": 1700000000000}), م.uuid7({"زمن": 1700000000000})]
    م.ضبط_المصدر(م.مولد_بذرة("بذرة"))
    خل ب = [م.uuid4(), م.nanoid(10), م.ulid({"زمن": 1700000000000}), م.uuid7({"زمن": 1700000000000})]
    م.اعد_المصدر_الافتراضي()
    اختبار.يساوي(أ, ب)
  })
  اختبار.اختبر("بذور مختلفة تعطي نتائج مختلفة", دالة() {
    خل أ = م.uuid4({"عشوائي": م.مولد_بذرة(1)}); خل ب = م.uuid4({"عشوائي": م.مولد_بذرة(2)})
    اختبار.لا_يساوي(أ, ب)
  })
  اختبار.اختبر("مصدر مخصص خاطئ الطول يُرفض", دالة() { اختبار.يرمي(() => م.uuid4({"عشوائي": (ن) => "00"})) })
})

اختبار.مجموعة("ULID", دالة() {
  اختبار.اختبر("متجهات المواصفة", دالة() {
    اختبار.يساوي(م.وحدات["ulid"].زمن_من("01ARZ3NDEKTSV4RRFFQ69G5FAV"), 1469922850259)
    اختبار.يساوي(م.ulid({"زمن": 1469918176385, "عشوائي": (ن) => "00" * ن}), "01ARYZ6S410000000000000000")
  })
  اختبار.اختبر("ترتيب وفرادة (مرتب داخل نفس المللي)", دالة() {
    خل ق = م.دفعة(() => م.ulid(), 3000)
    اختبار.هو_صح(_مرتب(ق)); اختبار.يساوي(ق.فريد().طول, 3000)
  })
  اختبار.اختبر("التحقق: Crockford وحروف ملتبسة", دالة() {
    اختبار.هو_صح(م.وحدات["ulid"].هل_صالح("01arz3ndektsv4rrffq69g5fav"))
    اختبار.هو_غلط(م.وحدات["ulid"].هل_صالح("01ARZ3NDEKTSV4RRFFQ69G5FAU"))   // U ليست في الأبجدية
    اختبار.هو_غلط(م.وحدات["ulid"].هل_صالح("81ARZ3NDEKTSV4RRFFQ69G5FAV"))   // يفيض 128 بت
    اختبار.هو_غلط(م.وحدات["ulid"].هل_صالح("123"))
