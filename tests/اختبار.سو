  اختبار.اختبر("الإنتروبيا", دالة() {
    اختبار.قريب(م.وحدات["nanoid"].بتات_العشوائية(21), 126, 0.001)
    اختبار.يساوي(م.وحدات["nanoid"].طول_مطلوب(128, "ارقام"), 39)
