    اختبار.يساوي(م.وحدات["ulid"].من_uuid(ع), "01ARZ3NDEKTSV4RRFFQ69G5FAV")
    اختبار.يساوي(م.زمن_معرف(م.uuid7({"زمن": 1700000000000})), م.وحدات["ulid"].زمن_من(م.وحدات["ulid"].من_uuid(م.uuid7({"زمن": 1700000000000}))))
  })
