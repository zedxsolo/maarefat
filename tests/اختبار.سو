اختبار.مجموعة("KSUID وObjectId وSnowflake", دالة() {
  اختبار.اختبر("KSUID (متجه segmentio)", دالة() {
    خل ك = م.وحدات["ksuid"].من_اجزاء(107608047 + 1400000000, "b5a1cd34b5f99d1154fb6853345c9735")
    اختبار.يساوي(ك, "0ujtsYcgvSTl8PAuAdqWYSMnLOv")
    اختبار.يساوي(م.وحدات["ksuid"].حلل(ك), {"ثواني": 1507608047, "حمولة": "b5a1cd34b5f99d1154fb6853345c9735"})
    اختبار.يساوي(م.ksuid().طول, 27)
  })
  اختبار.اختبر("KSUID مرتب زمنياً", دالة() {
    اختبار.هو_صح(م.وحدات["ksuid"].من_اجزاء(1600000000, "00" * 16) < م.وحدات["ksuid"].من_اجزاء(1600000001, "00" * 16))
  })
  اختبار.اختبر("ObjectId", دالة() {
    خل ع = م.objectid()
    اختبار.يساوي(ع.طول, 24); اختبار.هو_صح(م.وحدات["objectid"].هل_صالح(ع))
    اختبار.لا_يساوي(ع, م.objectid())
    اختبار.يساوي(م.وحدات["objectid"].زمن_من(م.objectid({"زمن_ثواني": 1700000000})), 1700000000)
    اختبار.يساوي(م.دفعة(() => م.objectid(), 2000).فريد().طول, 2000)
  })
  اختبار.اختبر("Snowflake: فك معرف ديسكورد حقيقي", دالة() {
    اختبار.يساوي(م.وحدات["snowflake"].فك_ديسكورد("175928847299117063"), {"زمن": 1462015105796, "عامل": 1, "عملية": 0, "تسلسل": 7})
  })
  اختبار.اختبر("Snowflake: ترتيب وفرادة وفك", دالة() {
    خل س = م.snowflake(5)
    خل ق = م.دفعة(() => س.جديد(), 6000)
    اختبار.يساوي(ق.فريد().طول, 6000)
    لكل ي في مدى(1, ق.طول) { اختبار.يساوي(ضخم.قارن(ق[ي], ق[ي - 1]), 1) }
    اختبار.يساوي(م.وحدات["snowflake"].فك(ق[0])["عقدة"], 5)
    اختبار.يساوي(م.وحدات["snowflake"].فك(س.جديد(1700000000000 + 1))["زمن"] >= 1700000000000, صح)
  })
  اختبار.اختبر("Snowflake: عقدة غير صالحة", دالة() { اختبار.يرمي(() => م.snowflake(5000)) })
})

اختبار.مجموعة("NanoID", دالة() {
