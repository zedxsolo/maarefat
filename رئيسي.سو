// معرفات — مكتبة المعرّفات الشاملة للغة سولان
// UUID (الإصدارات 1–8 وفق RFC 9562) + ULID + NanoID + KSUID + ObjectId + Snowflake + TypeID + Sqids + أكواد مقروءة + فحص تلقائي + حاسبة تصادم
//
//   استورد "معرفات"
//   اطبع(معرفات.uuid7())            // معرّف زمني مرتب (الأفضل لقواعد البيانات)
//   اطبع(معرفات.معرف_عشوائي())      // UUID v4
//
// كل ما يُعرَّف في المستوى الأعلى هنا هو الواجهة العامة. الأسماء التي تبدأ بـ _ داخلية.

استورد "./src/اساس" باسم _اساس
استورد "./src/md5" باسم _md5
استورد "./src/uuid" باسم _uuid
استورد "./src/ulid" باسم _ulid
استورد "./src/nanoid" باسم _nanoid
استورد "./src/ksuid" باسم _ksuid
استورد "./src/objectid" باسم _objectid
استورد "./src/snowflake" باسم _snowflake
استورد "./src/typeid" باسم _typeid
استورد "./src/short" باسم _short
استورد "./src/sqids" باسم _sqids
استورد "./src/رموز" باسم _رموز
استورد "./src/حرفي" باسم _حرفي
استورد "./src/فحص" باسم _فحص
استورد "./src/احتمالات" باسم _احتمالات

خل النسخة_المكتبة = "1.0.0"

// ───────── الوحدات الكاملة (لكل ما لا يظهر هنا) ─────────
خل وحدات = {
  "اساس": _اساس, "uuid": _uuid, "ulid": _ulid, "nanoid": _nanoid, "ksuid": _ksuid, "objectid": _objectid,
  "snowflake": _snowflake, "typeid": _typeid, "short": _short, "sqids": _sqids, "رموز": _رموز,
  "حرفي": _حرفي, "فحص": _فحص, "احتمالات": _احتمالات, "md5": _md5
}

// ───────── UUID ─────────
خل uuid1 = _uuid.uuid1         // زمن + عقدة
خل uuid2 = _uuid.uuid2         // DCE Security
خل uuid3 = _uuid.uuid3         // اسم + MD5
خل uuid4 = _uuid.uuid4         // عشوائي
خل uuid5 = _uuid.uuid5         // اسم + SHA-1
خل uuid6 = _uuid.uuid6         // v1 مرتّب زمنياً
خل uuid7 = _uuid.uuid7         // زمن unix مرتّب + عشوائي (موصى به)
خل uuid8 = _uuid.uuid8         // مخصص
خل uuid8_sha256 = _uuid.uuid8_sha256
خل NIL = _uuid.فارغ_uuid
خل MAX = _uuid.اقصى_uuid
خل فضاءات = _uuid.فضاءات
خل حلل_uuid = _uuid.حلل
خل هل_uuid = _uuid.هل_صالح
خل نسق_معرف = _uuid.نسق_معرف
خل نسخة_uuid = _uuid.نسخة_من
خل متغير_uuid = _uuid.متغير_من
خل زمن_معرف = _uuid.زمن_معرف
خل قارن_معرفات = _uuid.قارن_معرفات
خل رتب_معرفات = _uuid.رتب_معرفات
خل v1_الى_v6 = _uuid.v1_الى_v6
خل v6_الى_v1 = _uuid.v6_الى_v1
خل v7_حد = _uuid.v7_حد
خل معرف = _uuid.معرف           // كائن UUID

// أسماء عربية وصفية
خل معرف_عشوائي = _uuid.uuid4
خل معرف_زمني = _uuid.uuid7
خل معرف_اسم = _uuid.uuid5
خل معرف_اسم_md5 = _uuid.uuid3
خل معرف_ساعة = _uuid.uuid1
خل معرف_ساعة_مرتب = _uuid.uuid6
خل معرف_مخصص = _uuid.uuid8

// ───────── بقية الأنواع ─────────
خل ulid = _ulid.جديد
خل nanoid = _nanoid.جديد
خل ksuid = _ksuid.جديد
خل objectid = _objectid.جديد
خل typeid = _typeid.جديد
خل cuid = _حرفي.جديد
خل short_uuid = _short.جديد
خل sqids = _sqids.جديد
خل snowflake = _snowflake.مولد_جديد
خل رمز_مقروء = _رموز.رمز
خل رمز_رقمي = _رموز.رمز_رقمي
خل رمز_دعوة = _رموز.رمز_دعوة
خل هل_رمز_صالح = _رموز.هل_رمز_صالح

// ───────── أدوات ─────────
خل افحص = _فحص.افحص
خل احتمال_تصادم = _احتمالات.احتمال_تصادم
خل تقرير_تصادم = _احتمالات.تقرير
خل كمية_آمنة = _احتمالات.كمية_آمنة
خل مولد_بذرة = _اساس.مولد_بذرة          // مصدر عشوائية حتمي للاختبارات
خل ضبط_المصدر = _اساس.ضبط_المصدر
خل اعد_المصدر_الافتراضي = _اساس.اعد_المصدر_الافتراضي

// دفعة من المعرفات: دفعة(ف, عدد) أو دفعة(ف, عدد, غلط) للسماح بالتكرار
دالة دفعة(ف, عدد, فريد = صح) {
  خل خ = []
  اذا ليس فريد {
    لكل ر في مدى(0, عدد) { خ.اضف(ف()) }
    ارجع خ
  }
  خل ر = {}
  خل محاولات = 0
  طالما خ.طول < عدد {
    خل ك = ف()
    اذا ك في ر {
      محاولات += 1
      اذا محاولات > عدد * 10 + 100 { ارمي "تعذّر توليد " + نص(عدد) + " معرّفاً فريداً (المولّد يكرر نفسه كثيراً)" }
      استمر
    }
    ر[ك] = صح
    خ.اضف(ك)
  }
  ارجع خ
}

// ───────── سطر الأوامر ─────────
// solan رئيسي.سو <نوع> [-ن عدد] [وسائط]      مثال: solan رئيسي.سو v7 -ن 5
دالة _مساعدة() {
  اطبع("معرفات " + النسخة_المكتبة + " — مكتبة المعرّفات الشاملة للغة سولان")
  اطبع("")
  اطبع("الاستعمال: solan رئيسي.سو <أمر> [-ن عدد] [وسائط]")
  اطبع("")
  اطبع("  v1 v4 v6 v7          UUID بالإصدار المطلوب")
  اطبع("  v3|v5 <اسم> [فضاء]    UUID مبني على اسم (الفضاء الافتراضي dns)")
  اطبع("  ulid  nanoid [طول]  ksuid  objectid  typeid [بادئة]  cuid  short")
  اطبع("  افحص <معرف>          يتعرف على النوع ويستخرج الزمن والتفاصيل")
  اطبع("  تحقق <uuid>          هل هو UUID صالح؟")
  اطبع("  تصادم <نوع> <عدد>    احتمال التصادم (uuid4 uuid7 ulid nanoid ksuid ...)")
}
دالة _عرض_افحص(ن) {
  اذا ن["الاول"] == عدم { اطبع("لم أتعرف على نوع هذا المعرّف"); ارجع }
  لكل ك في ن["المرشحون"] {
    اطبع("● " + ك["نوع"] + " (" + ك["ثقة"] + ")")
    لكل م, ق في ك {
      اذا م == "نوع" او م == "ثقة" { استمر }
      اذا م == "زمن_مللي" { اطبع("    زمن: " + نص(ق) + " ms = " + _اساس.زمن_iso(ق)) }
      والا { اطبع("    " + م + ": " + نص(ق)) }
    }
  }
}
دالة _شغل(ا) {
  اذا ا.طول == 0 او ا[0] == "-h" او ا[0] == "--help" او ا[0] == "مساعدة" { _مساعدة(); ارجع }
  خل امر = ا[0]
  خل عدد = 1
  خل موضعية = []
  خل ي = 1
  طالما ي < ا.طول {
    اذا ا[ي] == "-n" او ا[ي] == "-ن" او ا[ي] == "--عدد" { عدد = رقم(ا[ي + 1]) ?? 1; ي += 2 }
    والا { موضعية.اضف(ا[ي]); ي += 1 }
  }
  خل م1 = موضعية.طول > 0 ? موضعية[0] : عدم
  خل م2 = موضعية.طول > 1 ? موضعية[1] : "dns"
  تبديل امر {
    حالة "افحص" { _عرض_افحص(افحص(م1 ?? "")); ارجع }
    حالة "تحقق" { اطبع(هل_uuid(م1 ?? "") ? "صالح" : "غير صالح"); ارجع }
    حالة "تصادم" { اطبع(تقرير_تصادم(م1 ?? "uuid4", رقم(م2) ?? 1000000)); ارجع }
  }
  خل مولدات = {
    "v1": () => uuid1(), "v4": () => uuid4(), "v6": () => uuid6(), "v7": () => uuid7(), "v8": () => uuid8(),
    "v3": () => uuid3(م1 ?? "", م2), "v5": () => uuid5(م1 ?? "", م2),
    "ulid": () => ulid(), "nanoid": () => nanoid(رقم(م1 ?? "21") ?? 21), "ksuid": () => ksuid(),
    "objectid": () => objectid(), "typeid": () => typeid(م1 ?? ""), "cuid": () => cuid(), "short": () => short_uuid()
  }
  اذا ليس (امر في مولدات) { اطبع("أمر غير معروف: " + امر); _مساعدة(); نظام.اخرج(2) }
  لكل ر في مدى(0, عدد) { اطبع(مولدات[امر]()) }
}
اذا هو_الرئيسي { _شغل(وسائط) }
